<UserControl
    x:Class="RobotSimulator.Controls.RobotViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:macad="clr-namespace:Macad.Interaction.Panels;assembly=Macad.Interaction"
    Background="{DynamicResource 全局_按钮_白颜色}"
    x:Name="ViewerRoot">
    <!--  状态文字由宿主显示，控件本身只保留三维视口。  -->
    <Grid>
        <macad:ViewportPanel
            x:Name="RenderView"
            ToolTip="左键拖动旋转 · 右键拖动平移 · 滚轮缩放">
        </macad:ViewportPanel>
    </Grid>
</UserControl>
