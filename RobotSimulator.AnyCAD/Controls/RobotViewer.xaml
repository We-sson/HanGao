<UserControl
    x:Class="RobotSimulator.Controls.RobotViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anycad="clr-namespace:AnyCAD.WPF;assembly=AnyCAD.WPF.NET">
    <!-- 视口占满主体，左下角直接显示状态文字。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <anycad:RenderControl x:Name="RenderView" Grid.Row="0" />
        <TextBlock
            Grid.Row="1"
            Margin="8,2,0,2"
            Foreground="Black"
            Text="{Binding Model.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </Grid>
</UserControl>
