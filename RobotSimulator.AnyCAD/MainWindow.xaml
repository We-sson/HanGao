<Window
    x:Class="RobotSimulator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anycad="clr-namespace:AnyCAD.WPF;assembly=AnyCAD.WPF.NET"
    xmlns:behaviors="clr-namespace:RobotSimulator.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding WindowTitle}"
    Width="1380"
    Height="850"
    MinWidth="1050"
    MinHeight="680"
    Background="#0E1015"
    Foreground="White"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!-- DataContext 由 MainWindow 构造函数设置为 MainViewModel，页面通过 Binding 读取属性和命令。 -->
    <!-- Closing 事件把 CancelEventArgs 交给命令，允许 ViewModel 在模型读取中延迟关闭窗口。 -->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}" PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <!-- 三行：型号与视角工具栏、三维视图和运动控制、状态栏；左列自适应，右列为控制面板。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="410" />
        </Grid.ColumnDefinitions>

        <!-- 顶部工具栏：型号列表来自内置资源配置，视角按钮仅改变相机。 -->
        <Border
            x:Name="ResourceToolbar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#171A20"
            BorderBrush="#2A303A"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding ModelName}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Foreground="{StaticResource MutedBrush}"
                        Text="AnyCAD Rapid.NET · .NET 10 · STEP/B-Rep" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!-- 点击事件统一交给 ViewModel 命令，避免在窗口后台编写业务事件处理器。 -->
                    <Button Content="等轴测" IsEnabled="{Binding CanOperate}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding IsometricCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>
                    <Button Content="正视" IsEnabled="{Binding CanOperate}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding FrontCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>
                    <Button Content="俯视" IsEnabled="{Binding CanOperate}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding TopCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>
                    <Button
                        Margin="0"
                        Content="适合窗口"
                        IsEnabled="{Binding CanOperate}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding ZoomAllCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>
                </StackPanel>
                <!-- 三类资源使用同一行选择列表，自适应窗口宽度。 -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="机器人" />
                    <ComboBox x:Name="RobotSelector" Grid.Column="1" MinHeight="30" Margin="0,0,18,0"
                              AutomationProperties.Name="机器人型号" DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding RobotModels}" SelectedItem="{Binding SelectedRobot, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectRobot}" ToolTip="切换机器人，保留当前 Tool、工装及相机视角">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectRobotCommand}" CommandParameter="{Binding SelectedItem, ElementName=RobotSelector}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Text="Tool" />
                    <ComboBox x:Name="ToolSelector" Grid.Column="3" MinHeight="30" Margin="0,0,18,0"
                              AutomationProperties.Name="Tool 型号" DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding ToolModels}" SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectTool}" ToolTip="只替换 Tool，保留机器人和工装">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectToolCommand}" CommandParameter="{Binding SelectedItem, ElementName=ToolSelector}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                    <TextBlock Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center" Text="工装" />
                    <ComboBox x:Name="WorkSelector" Grid.Column="5" MinHeight="30"
                              AutomationProperties.Name="工装型号" DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding WorkModels}" SelectedItem="{Binding SelectedWork, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectWork}" ToolTip="每次显示一套工装，保留机器人姿态和 Tool">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectWorkCommand}" CommandParameter="{Binding SelectedItem, ElementName=WorkSelector}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>

        <!-- 左侧三维视口：AnyCAD 绘制机器人；其上的 WPF 元素显示单位提示和加载浮层。 -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="14"
            Background="#EFF3F8"
            BorderBrush="#2A303A"
            BorderThickness="1"
            CornerRadius="7">
            <Grid>
                <!-- AnyCAD 的 ViewerReady 是回调事件，通过自定义行为等渲染器就绪后再加载首个型号。 -->
                <anycad:RenderControl x:Name="RenderView">
                    <i:Interaction.Triggers>
                        <behaviors:ViewerReadyTrigger>
                            <i:InvokeCommandAction Command="{Binding ViewerReadyCommand}" />
                        </behaviors:ViewerReadyTrigger>
                    </i:Interaction.Triggers>
                </anycad:RenderControl>
                <!-- 此提示只说明模型单位和全局坐标约定，不参与三维场景变换。 -->
                <Border
                    Margin="14"
                    Padding="10,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#CC171A20"
                    CornerRadius="4">
                    <TextBlock Foreground="#C7CEDA" Text="单位：mm  ·  坐标系：右手系 / Z 向上" />
                </Border>
                <!-- 只在首次加载显示浮层；替换模型时保留当前画面，进度显示于状态栏。 -->
                <Border
                    Padding="24,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F4F7FA"
                    BorderBrush="#AEB8C4"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="{Binding ShowLoadingOverlay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel Width="310">
                        <Grid
                            Width="42"
                            Height="42"
                            HorizontalAlignment="Center">
                            <Ellipse Stroke="#D9DFE6" StrokeThickness="4" />
                            <Ellipse
                                RenderTransformOrigin="0.5,0.5"
                                Stroke="#F47B20"
                                StrokeDashArray="2,5"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="4">
                                <Ellipse.RenderTransform>
                                    <RotateTransform />
                                </Ellipse.RenderTransform>
                                <!-- WPF 故事板只旋转加载图标，不驱动机器人的关节动画。 -->
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                    From="0"
                                                    To="360"
                                                    Duration="0:0:1.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#20252C"
                            Text="正在加载模型" />
                        <TextBlock
                            Margin="0,6,0,12"
                            HorizontalAlignment="Center"
                            Foreground="#687382"
                            Text="{Binding LoadingMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Grid>
                            <ProgressBar
                                Height="8"
                                Background="#DDE3E9"
                                Foreground="{StaticResource AccentBrush}"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding LoadProgress}" />
                            <TextBlock
                                Margin="0,13,0,0"
                                HorizontalAlignment="Right"
                                Foreground="#687382"
                                Text="{Binding LoadProgress, StringFormat={}{0:F0}%}" />
                        </Grid>
                        <TextBlock
                            Margin="0,22,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="#87919D"
                            Text="首次解析后会生成显示缓存，后续启动将明显加快" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧调整关节、Tool TCP 与工装安装位置，机器人校准参数保持固定。 -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,14,14,14"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#2A303A"
            BorderThickness="1"
            CornerRadius="7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="16,16,16,10">
                    <Button x:Name="RobotSetupButton" Margin="0,0,0,12" HorizontalAlignment="Left"
                            Content="新机器人配置向导（开发）" Visibility="Collapsed"
                            IsEnabled="{Binding CanSelectRobot}" />
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="运动控制" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Foreground="{StaticResource MutedBrush}"
                        Text="Base → J1 → J2 → J3 → J4 → J5 → J6 → Tool" />
                    <!-- 三个开关各自双向绑定；Click 命令再把最新值同步到场景，彼此独立。 -->
                    <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding CanOperate}">
                        <WrapPanel.Resources>
                            <Style TargetType="CheckBox">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Margin" Value="0,0,14,0" />
                                <Setter Property="Padding" Value="4,7" />
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </WrapPanel.Resources>
                        <CheckBox Content="基坐标" IsChecked="{Binding ShowBaseCoordinates, Mode=TwoWay}" ToolTip="显示或隐藏固定在机器人底座的 XYZ 坐标轴">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding UpdateCoordinateVisibilityCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </CheckBox>
                        <CheckBox Content="法兰" IsChecked="{Binding ShowFlangeCoordinates, Mode=TwoWay}" ToolTip="显示或隐藏随末端法兰运动的 XYZ 坐标轴">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding UpdateCoordinateVisibilityCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </CheckBox>
                        <CheckBox Content="TCP" IsChecked="{Binding ShowTcpCoordinates, Mode=TwoWay}" ToolTip="显示或隐藏工具中心的 XYZ 坐标轴；位置和方向由 Tool 坐标参数决定">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding UpdateCoordinateVisibilityCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </CheckBox>
                    </WrapPanel>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                        <Run Text="XYZ 方向：" />
                        <Run Foreground="#FF8585" Text="X 红" />
                        <Run Text=" · " />
                        <Run Foreground="#8EDB96" Text="Y 绿" />
                        <Run Text=" · " />
                        <Run Foreground="#83BDFF" Text="Z 蓝" />
                    </TextBlock>
                    <!-- 相机环绕调试：速度 0 停止；角度为绕模型中心的起始方位角。 -->
                    <Grid Margin="0,10,0,0" IsEnabled="{Binding CanOperate}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="#C7CEDA"
                            Text="环绕速度" />
                        <Slider
                            Grid.Column="1"
                            Margin="10,0"
                            IsSnapToTickEnabled="True"
                            Maximum="60"
                            Minimum="0"
                            TickFrequency="1"
                            Value="{Binding OrbitSpeed, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="#C7CEDA"
                            Text="{Binding OrbitSpeed, StringFormat={}{0:F0}°/s}" />
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Foreground="#C7CEDA"
                            Text="起始角度" />
                        <Slider
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="10,0"
                            IsSnapToTickEnabled="True"
                            Maximum="180"
                            Minimum="-180"
                            TickFrequency="1"
                            Value="{Binding OrbitAngle, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="#C7CEDA"
                            Text="{Binding OrbitAngle, StringFormat={}{0:F0}°}" />
                    </Grid>
                </StackPanel>

                <TabControl
                    Grid.Row="1"
                    IsEnabled="{Binding CanOperate}"
                    Margin="12,0,12,10"
                    Background="Transparent"
                    BorderBrush="#343A46">
                    <!-- 每一项的数据源是一个 JointViewModel，滑块和数字框共同绑定该轴的 Angle。 -->
                    <TabItem Header="关节运动">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl Margin="8" ItemsSource="{Binding Joints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            Background="{StaticResource CardBrush}"
                                            CornerRadius="5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    Text="{Binding ControllerAxis}" />
                                                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}">
                                                    <Run Text="范围 " />
                                                    <Run Text="{Binding Minimum, Mode=OneWay, StringFormat={}{0:F0}}" />
                                                    <Run Text="° ～ " />
                                                    <Run Text="{Binding Maximum, Mode=OneWay, StringFormat={}{0:F0}}" />
                                                    <Run Text="°" />
                                                </TextBlock>
                                                <!-- 文本框失去焦点后提交数值；滑块则在拖动时实时提交。 -->
                                                <TextBox
                                                    Grid.Column="2"
                                                    HorizontalContentAlignment="Right"
                                                    Text="{Binding Angle, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}" />
                                                <Slider
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="3"
                                                    Margin="0,9,0,0"
                                                    Maximum="{Binding Maximum, Mode=OneWay}"
                                                    Minimum="{Binding Minimum, Mode=OneWay}"
                                                    Value="{Binding Angle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TCP 使用法兰局部坐标；XYZ 为 mm，ABC 为度，编辑它不会移动 Tool 几何。 -->
                    <TabItem Header="Tool 坐标">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10" IsEnabled="{Binding CanEditTool}">
                                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding ToolName}" />
                                <TextBlock
                                    Margin="0,0,0,12"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="工具原点安装到当前机器人的法兰，XYZ 对齐法兰方向；同一 Tool 可搭配不同机器人。"
                                    TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" Text="KUKA TCP（$TOOL）" />
                                <TextBlock
                                    Margin="0,4,0,8"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="相对于 A6 法兰坐标系；采用 KUKA X/Y/Z/A/B/C，旋转顺序 Rz(A)·Ry(B)·Rx(C)。"
                                    TextWrapping="Wrap" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,6,8">
                                        <TextBlock Text="X / mm" />
                                        <TextBox Text="{Binding ToolTcpX, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                    </StackPanel>
                                    <StackPanel Margin="3,0,3,8">
                                        <TextBlock Text="Y / mm" />
                                        <TextBox Text="{Binding ToolTcpY, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,8">
                                        <TextBlock Text="Z / mm" />
                                        <TextBox Text="{Binding ToolTcpZ, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,8">
                                        <TextBlock Text="A / °" />
                                        <TextBox Text="{Binding ToolTcpA, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                    </StackPanel>
                                    <StackPanel Margin="3,0,3,8">
                                        <TextBlock Text="B / °" />
                                        <TextBox Text="{Binding ToolTcpB, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,8">
                                        <TextBlock Text="C / °" />
                                        <TextBox Text="{Binding ToolTcpC, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="WorkInstallationTab" Header="工装安装">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="{Binding WorkName}" />
                                <TextBlock Margin="0,0,0,12" Foreground="{StaticResource MutedBrush}"
                                           Text="以机器人基坐标为安装基准。XYZ/ABC 全为 0 时，保留 CAD 导出的装配位置；调整数值会整体移动工装。工装不随关节运动。"
                                           TextWrapping="Wrap" />
                                <StackPanel IsEnabled="{Binding CanEditWork}">
                                    <TextBlock FontWeight="SemiBold" Text="工装安装位置" />
                                    <TextBlock Margin="0,4,0,8" Foreground="{StaticResource MutedBrush}"
                                               Text="XYZ 单位 mm；ABC 单位度，旋转顺序 Rz(A)·Ry(B)·Rx(C)。"
                                               TextWrapping="Wrap" />
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,6,8">
                                            <TextBlock Text="X / mm" />
                                            <TextBox AutomationProperties.Name="工装 X，毫米" Text="{Binding WorkX, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                        </StackPanel>
                                        <StackPanel Margin="3,0,3,8">
                                            <TextBlock Text="Y / mm" />
                                            <TextBox AutomationProperties.Name="工装 Y，毫米" Text="{Binding WorkY, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,8">
                                            <TextBlock Text="Z / mm" />
                                            <TextBox AutomationProperties.Name="工装 Z，毫米" Text="{Binding WorkZ, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,8">
                                            <TextBlock Text="A / °" />
                                            <TextBox AutomationProperties.Name="工装 A，度" Text="{Binding WorkA, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                        </StackPanel>
                                        <StackPanel Margin="3,0,3,8">
                                            <TextBlock Text="B / °" />
                                            <TextBox AutomationProperties.Name="工装 B，度" Text="{Binding WorkB, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,8">
                                            <TextBlock Text="C / °" />
                                            <TextBox AutomationProperties.Name="工装 C，度" Text="{Binding WorkC, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Margin="0,6,0,12" Columns="2">
                                        <Button Margin="0,0,6,0" Content="保存工装配置" Command="{Binding SaveWorkConfigurationCommand}" />
                                        <Button Margin="6,0,0,0" Content="重新载入工装" Command="{Binding ReloadWorkCommand}"
                                                ToolTip="重新读取已保存的位置，替换未保存的修改" />
                                    </UniformGrid>
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding WorkStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- 保存和重载只作用于独立 tool.json，不输出或改写机器人参数。 -->
                <StackPanel Grid.Row="2" Margin="16,0,16,16">
                    <Border
                        Margin="0,0,0,12"
                        Padding="10,8"
                        Background="#11141A"
                        CornerRadius="4">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding ToolStatus}" />
                    </Border>
                    <UniformGrid Columns="2">
                        <Button
                            Margin="0,0,6,0"
                            Content="回到初始位"
                            IsEnabled="{Binding CanOperate}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding ResetCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                        <Button
                            Margin="6,0,0,0"
                            Background="#B95716"
                            BorderBrush="#E57A31"
                            Content="{Binding PlayButtonText}"
                            IsEnabled="{Binding CanOperate}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding PlayCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </UniformGrid>
                    <UniformGrid Margin="0,10,0,0" Columns="2">
                        <Button
                            Margin="0,0,6,0"
                            Content="保存 Tool 配置"
                            IsEnabled="{Binding CanEditTool}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding SaveToolConfigurationCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                        <Button
                            Margin="6,0,0,0"
                            Content="重新载入 Tool"
                            IsEnabled="{Binding CanEditTool}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding ReloadToolCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态栏：显示当前加载步骤、关节角度、保存结果或异常摘要。 -->
        <Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Background="#171A20"
            BorderBrush="#2A303A"
            BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse
                    Width="8"
                    Height="8"
                    Margin="0,0,8,0"
                    Fill="{StaticResource AccentBrush}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="#C7CEDA"
                    Text="{Binding StatusMessage}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource MutedBrush}"
                    Text="AnyCAD 2026.8.6.1458" />
            </Grid>
        </Border>
    </Grid>
</Window>
