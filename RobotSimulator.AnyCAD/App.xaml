<Application x:Class="RobotSimulator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup"
             Exit="Application_Exit">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="PanelBrush" Color="#171A20" />
        <SolidColorBrush x:Key="CardBrush" Color="#22262E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F47B20" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B2" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#343A46" />
            <Setter Property="BorderBrush" Value="#48505E" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#11141A" />
            <Setter Property="BorderBrush" Value="#48505E" />
            <Setter Property="Padding" Value="5,3" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="8,0" />
        </Style>
    </Application.Resources>
</Application>
