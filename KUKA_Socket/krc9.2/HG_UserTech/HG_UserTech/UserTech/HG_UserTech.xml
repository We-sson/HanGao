<?xml version="1.0" encoding="utf-8"?>
<KukaTechConfiguration xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="HG_UserTech" Version="8.2.1.0">
  <Application Key="ProgCallComment" Name="Program Call / Comment" ApplicationIcon="">
    <Parameters>
      <NameParameter Key="ProgName" Name="ProgramName: " Enabled="true" Default="Program" />
      <SwitchParameter Key="ProgActionSwitch" Name="Action:" Enabled="true" SelectedCase="Comment">
        <CaseItem Key="Call" Disp="Run">
          <ParameterRef Key="ProgName" />
          <LineBreak />
          <KrlLine>%ProgName/()</KrlLine>
        </CaseItem>
        <CaseItem Key="Comment" Disp="No">
          <ParameterRef Key="ProgName" />
          <LineBreak />
          <KrlLine>;%ProgName/()</KrlLine>
        </CaseItem>
      </SwitchParameter>
    </Parameters>
    <Scripts />
    <Inlineforms>
      <InlineForm Key="ProgCallCommentIlf" Name="HG" Spline="false" Focus="0" OnOpen="" OnTouchUp="" OnAccept="" OnSoftKey1Click="" OnSoftKey2Click="" OnSoftKey3Click="" OnSoftKey4Click="" InlineFormIcon="" DisplayText="HG Name: %ProgName/   State:  %ProgActionSwitch/ ">
        <ParameterRef Key="ProgActionSwitch" />
        <KrlLine>%ProgActionSwitch/</KrlLine>
        <LineBreak />
      </InlineForm>
    </Inlineforms>
    <StatKeys />
    <StatKeyBars />
  </Application>
  <Application Key="ArcDateSet" Name="ArcDateSet">
    <Parameters>
      <ListParameter Key="ArcParList" Name="ArcParList" Enabled="true" OnValueChange="ReadArcParName" SelectedItem="1" Mapping="dArcPsWdatWeld[].Name[]">
        <ListItem Key="1" Disp="" />
      </ListParameter>
      <NumberParameter Key="Power" Name="Power" Enabled="true" Unit="%" Default="30" Min="0" Max="100" Step="1" />
      <NumberParameter Key="Laser_IO" Name="Laser_IO" Enabled="true" Unit="No" Default="0" Min="0" Max="7" Step="1" />
      <NumberParameter Key="PWM_Duty" Name="PWM_Duty" Enabled="true" Unit="%" Default="30" Min="0" Max="100" Step="1" />
      <NumberParameter Key="PWM_Freq" Name="PWM_Freq" Enabled="true" Unit="Hz" Default="5" Min="1" Max="20000" Step="0" />
      <RealParameter Key="Rob_Vel" Name="Rob_Vel" Enabled="true" Unit="m/s" Default="0.1" Min="0.001" Max="0.4" Step="0.01" />
      <FreeParameter Key="ArcParName" Name="ArcParName" Enabled="true" OnValueChange="ReadArcParName" Default=" " UseExpressionEditor="False" />
      <SwitchParameter Key="ArcPar_Type" Name="ArcPar_Type" Enabled="true" SelectedCase="CaseItemKey">
        <CaseItem Key="CaseItemKey" Disp="Start">
          <LineBreak />
          <KrlLine>dArcPsWdatWeld[%ArcParList/].Velocity=%Rob_Vel/</KrlLine>
          <KrlLine>dArcPsWdatWeld[%ArcParList/].C1=%Power/</KrlLine>
          <KrlLine>dArcPsWdatWeld[%ArcParList/].C2=%Laser_IO/</KrlLine>
          <KrlLine>dArcPsWdatWeld[%ArcParList/].C3=%PWM_Duty/</KrlLine>
          <KrlLine>dArcPsWdatWeld[%ArcParList/].C4=%PWM_Freq/</KrlLine>
          <KrlLine>ArcCallChangeBefore({Action #enArcChangeBefore,WDAT{Weld %ArcParList/,Weave 0,Track 0,ThermalControl 0}})</KrlLine>
        </CaseItem>
        <CaseItem Key="CaseItemKey1" Disp="Switch">
          <LineBreak />
          <KrlLine>ArcCallChangeBefore({Action #enArcChangeBefore,WDAT{Weld %ArcParList/,Weave 0,Track 0,ThermalControl 0}})</KrlLine>
          <KrlLine>TRIGGER WHEN PATH = 0.0 ONSTART DELAY = 0 DO LaserDatM(%ArcParList/ , %Rob_Vel/ , %Power/ , %Laser_IO/ , %PWM_Duty/ , %PWM_Freq/) PRIO = -1</KrlLine>
          <KrlLine>TRIGGER WHEN PATH = 0.0 ONSTART DELAY = 0 DO ArcCallChange({Action #enArcChange,WDAT{Weld %ArcParList/ ,Weave 0,Track 0,ThermalControl 0}}) PRIO = -1</KrlLine>
        </CaseItem>
      </SwitchParameter>
      <SwitchParameter Key="Work_Name" Name="Work_Name" Enabled="true" SelectedCase="A">
        <CaseItem Key="A" Disp="A工装" StatementDisplay="A工装">
          <LineBreak />
          <KrlLine>Work_Air_A_Set(%Work_Back/,%Work_Down/,%Work_Push/,%Work_Up/)</KrlLine>
        </CaseItem>
        <CaseItem Key="C" Disp="C工装" StatementDisplay="C工装">
          <LineBreak />
          <KrlLine>Work_Air_C_Set(%Work_Back/,%Work_Down/,%Work_Push/,%Work_Up/)</KrlLine>
        </CaseItem>
      </SwitchParameter>
      <RealParameter Key="Work_Back" Name="Work_Back" Enabled="true" Unit="Mpa" Default="1" Min="0" Max="10" Step="0.1" />
      <RealParameter Key="Work_Down" Name="Work_Down" Enabled="true" Unit="Mpa" Default="1" Min="0" Max="10" Step="0.1" />
      <RealParameter Key="Work_Push" Name="Work_Push" Enabled="true" Unit="Mpa" KrlName="" Default="1" Min="0" Max="10" Step="0.1" />
      <RealParameter Key="Work_Up" Name="Work_Up" Enabled="true" Unit="Mpa" Default="1" Min="0" Max="10" Step="0.1" />
    </Parameters>
    <Scripts>
      <Script Key="ReadArcParName">
        <ShowVar FullPath="dArcPsWdatWeld[%ArcParList/].Name[]" Param="ArcParName" />
      </Script>
    </Scripts>
    <Inlineforms>
      <InlineForm Key="ArcParSet" Name="ArcParSet" Spline="false" Focus="0" OnOpen="Nothing" OnTouchUp="" OnAccept="ReadArcParName" OnSoftKey1Click="" OnSoftKey2Click="" OnSoftKey3Click="" OnSoftKey4Click="" InlineFormIcon="" DisplayText="HG:%ArcPar_Type/%ArcParName/ 速度=%Rob_Vel/mm/s 功率:%Power/% 焊接长度:%PWM_Duty/%  焊接频率:%PWM_Freq/Hz  焊接头序号:%Laser_IO/   " EnableHotEdit="True">
        <ParameterRef Key="ArcPar_Type" />
        <ParameterRef Key="ArcParList" />
        <ParameterRef Key="Power" />
        <ParameterRef Key="Laser_IO" />
        <ParameterRef Key="PWM_Duty" />
        <ParameterRef Key="PWM_Freq" />
        <ParameterRef Key="Rob_Vel" />
        <KrlLine>%ArcPar_Type/ </KrlLine>
        <LineBreak />
      </InlineForm>
      <InlineForm Key="Work_Air_Set" Name="Work_Air_Set" Spline="false" Focus="0" OnOpen="Nothing" OnTouchUp="" OnAccept="Nothing" OnSoftKey1Click="" OnSoftKey2Click="" OnSoftKey3Click="" OnSoftKey4Click="" InlineFormIcon="" DisplayText="%Work_Name/=夹爪夹紧:%Work_Back/Mpa  夹爪下降:%Work_Down/Mpa 侧推:%Work_Push/Mpa  底部顶起:%Work_Up/Mpa " EnableHotEdit="True">
        <ParameterRef Key="Work_Name" />
        <ParameterRef Key="Work_Back" />
        <ParameterRef Key="Work_Down" />
        <ParameterRef Key="Work_Push" />
        <ParameterRef Key="Work_Up" />
        <KrlLine>%Work_Name/ </KrlLine>
        <LineBreak />
      </InlineForm>
    </Inlineforms>
    <StatKeys />
    <StatKeyBars />
  </Application>
</KukaTechConfiguration>