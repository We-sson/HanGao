&ACCESS RVO
&REL 25
&PARAM DISKPATH = KRC:\R1\HG_Mes
DEF Tooling_Main()
;----- Fixture B buttons: IN19 / IN20  ->  INT 23 / 24
INTERRUPT DECL 23 WHEN $IN[12] == TRUE DO Grip_Button_1_B()
INTERRUPT DECL 24 WHEN $IN[13] == TRUE DO Grip_Button_2_B()
INTERRUPT ON 23
INTERRUPT ON 24
;Grip_Reset_B=FALSE
LOOP
Grip_Tool_B()
ENDLOOP
END

GLOBAL DEF Grip_Tool_A()
IF (Grip_1_A == FALSE) AND (Grip_2_A == FALSE) AND (Grip_OK_A == FALSE) THEN
Grip_Reset_A=TRUE
grip_action_0_A()
ENDIF
IF (Grip_1_A == TRUE) AND (Grip_2_A == FALSE) AND (Grip_OK_A == FALSE) AND (Grip_Reset_A == TRUE) THEN
grip_action_1_A()
ENDIF
IF (Grip_1_A == TRUE) AND (Grip_2_A == TRUE) AND (Grip_OK_A == FALSE) AND (Grip_Reset_A == TRUE) THEN
Grip_OK_A=TRUE
Grip_Reset_A=FALSE
grip_action_2_A()
ENDIF
;-------------------------------------------------
IF (Grip_2_A == TRUE) AND (Grip_1_A == FALSE) AND (Grip_OK_A == TRUE) AND (Grip_Reset_A == FALSE) THEN
grip_action_3_A()
ENDIF
IF (Grip_2_A == FALSE) AND (Grip_1_A == TRUE) AND (Grip_OK_A == TRUE) AND (Grip_Reset_A == FALSE) THEN
grip_action_3_A()
ENDIF
IF (Grip_2_A == FALSE) AND (Grip_1_A == FALSE) AND (Grip_OK_A == TRUE) AND (Grip_Reset_A == FALSE) THEN
grip_action_0_A()
Grip_Reset_A=TRUE
Grip_OK_A=FALSE
ENDIF
IF Reset_Tooling_A == TRUE THEN
grip_action_3_A()
grip_action_0_A()
Reset_Tooling_A=FALSE
Grip_Reset_A=FALSE
Grip_1_A=FALSE
$OUT[7] = FALSE
Grip_2_A=FALSE
$OUT[8] = FALSE
ENDIF
END

GLOBAL DEF Grip_Button_1_A()
INTERRUPT OFF 21
Button_1_On_A=TRUE
IF (Button_1_On_A == TRUE) AND (Grip_1_A == FALSE) THEN
Grip_1_A=TRUE
$OUT[7] = TRUE
Button_1_On_A=FALSE
ENDIF
IF (Button_1_On_A == TRUE) AND (Grip_1_A == TRUE) THEN
Grip_1_A=FALSE
$OUT[7] = FALSE
Button_1_On_A=FALSE
ENDIF
INTERRUPT ON 21
WAIT SEC 0.1
END

GLOBAL DEF Grip_Button_2_A()
INTERRUPT OFF 22
Button_2_On_A=TRUE
IF (Button_2_On_A == TRUE) AND (Grip_2_A == FALSE) THEN
Grip_2_A=TRUE
$OUT[8] = TRUE
Button_2_On_A=FALSE
ENDIF
IF (Button_2_On_A == TRUE) AND (Grip_2_A == TRUE) THEN
Grip_2_A=FALSE
$OUT[8] = FALSE
Button_2_On_A=FALSE
ENDIF
INTERRUPT ON 22
WAIT SEC 0.1
END

DEF grip_action_0_A()
$OUT[29] = TRUE
$OUT[17] = TRUE
$OUT[18] = FALSE
$OUT[19] = FALSE
$OUT[20] = TRUE
$OUT[21] = FALSE
$OUT[22] = TRUE
END

DEF grip_action_1_A()
$OUT[17] = TRUE
$OUT[18] = FALSE
$OUT[19] = TRUE
$OUT[20] = FALSE
$OUT[21] = TRUE
$OUT[22] = FALSE
END

DEF grip_action_2_A()
$OUT[17] = FALSE
$OUT[18] = TRUE
$OUT[19] = TRUE
$OUT[20] = FALSE
$OUT[21] = TRUE
$OUT[22] = FALSE
WAIT SEC 2
$OUT[21] = TRUE
$OUT[22] = FALSE
$OUT[19] = FALSE
$OUT[20] = TRUE
WAIT SEC 0.3
$OUT[19] = TRUE
$OUT[20] = FALSE
WAIT SEC 0.3
$OUT[19] = FALSE
$OUT[20] = TRUE
END

DEF grip_action_3_A()
$OUT[29] = FALSE
WAIT SEC .5
$OUT[19] = TRUE
$OUT[20] = FALSE
WAIT SEC 0.3
$OUT[17] = TRUE
$OUT[18] = FALSE
WAIT SEC 0.5
END

GLOBAL DEF Grip_Tool_B()
IF (Grip_1_B == FALSE) AND (Grip_2_B == FALSE) AND (Grip_OK_B == FALSE) THEN
Grip_Reset_B=TRUE
grip_action_0_B()
ENDIF
IF (Grip_1_B == TRUE) AND (Grip_2_B == FALSE) AND (Grip_OK_B == FALSE) AND (Grip_Reset_B == TRUE) THEN
grip_action_1_B()
ENDIF
IF (Grip_1_B == TRUE) AND (Grip_2_B == TRUE) AND (Grip_OK_B == FALSE) AND (Grip_Reset_B == TRUE) THEN
Grip_OK_B=TRUE
Grip_Reset_B=FALSE
grip_action_2_B()
ENDIF
;-------------------------------------------------
IF (Grip_2_B == TRUE) AND (Grip_1_B == FALSE) AND (Grip_OK_B == TRUE) AND (Grip_Reset_B == FALSE) THEN
grip_action_3_B()
ENDIF
IF (Grip_2_B == FALSE) AND (Grip_1_B == TRUE) AND (Grip_OK_B == TRUE) AND (Grip_Reset_B == FALSE) THEN
grip_action_3_B()
ENDIF
IF (Grip_2_B == FALSE) AND (Grip_1_B == FALSE) AND (Grip_OK_B == TRUE) AND (Grip_Reset_B == FALSE) THEN
Grip_Reset_B=TRUE
Grip_OK_B=FALSE
grip_action_0_B()
ENDIF
IF Reset_Tooling_B == TRUE THEN
grip_action_3_B()
grip_action_0_B()
Reset_Tooling_B=FALSE
Grip_Reset_B=FALSE
Grip_1_B=FALSE
$OUT[9] = FALSE
Grip_2_B=FALSE
$OUT[10] = FALSE
ENDIF
END

GLOBAL DEF Grip_Button_1_B()
INTERRUPT OFF 23
Button_1_On_B=TRUE
IF (Button_1_On_B == TRUE) AND (Grip_1_B == FALSE) THEN
Grip_1_B=TRUE
$OUT[9] = TRUE
Button_1_On_B=FALSE
ENDIF
IF (Button_1_On_B == TRUE) AND (Grip_1_B == TRUE) THEN
Grip_1_B=FALSE
$OUT[9] = FALSE
Button_1_On_B=FALSE
ENDIF
INTERRUPT ON 23
WAIT SEC 0.1
END

GLOBAL DEF Grip_Button_2_B()
INTERRUPT OFF 24
Button_2_On_B=TRUE
IF (Button_2_On_B == TRUE) AND (Grip_2_B == FALSE) THEN
Grip_2_B=TRUE
$OUT[10] = TRUE
Button_2_On_B=FALSE
ENDIF
IF (Button_2_On_B == TRUE) AND (Grip_2_B == TRUE) THEN
Grip_2_B=FALSE
$OUT[10] = FALSE
Button_2_On_B=FALSE
ENDIF
INTERRUPT ON 24
WAIT SEC 0.1
END

DEF grip_action_0_B()
$OUT[30] = TRUE
$OUT[23] = TRUE
$OUT[24] = FALSE
$OUT[25] = FALSE
$OUT[26] = TRUE
$OUT[27] = FALSE
$OUT[28] = TRUE
END

DEF grip_action_1_B()
$OUT[23] = TRUE
$OUT[24] = FALSE
$OUT[25] = TRUE
$OUT[26] = FALSE
$OUT[27] = TRUE
$OUT[28] = FALSE
END

DEF grip_action_2_B()
$OUT[23] = FALSE
$OUT[24] = TRUE
$OUT[25] = TRUE
$OUT[26] = FALSE
$OUT[27] = TRUE
$OUT[28] = FALSE
WAIT SEC 2
$OUT[27] = TRUE
$OUT[28] = FALSE
$OUT[25] = FALSE
$OUT[26] = TRUE
WAIT SEC 0.3
$OUT[25] = TRUE
$OUT[26] = FALSE
WAIT SEC 0.5
$OUT[25] = FALSE
$OUT[26] = TRUE
END

DEF grip_action_3_B()
$OUT[30] = false
WAIT SEC .5
$OUT[25] = TRUE
$OUT[26] = FALSE
WAIT SEC 0.3
$OUT[23] = TRUE
$OUT[24] = FALSE
WAIT SEC 0.5
END