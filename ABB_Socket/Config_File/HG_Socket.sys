MODULE HG_Socket(SYSMODULE)

    ! Common 6-DOF pose record (merged from Glode_HanGao.sys)
    RECORD HPoint
        num x;
        num y;
        num z;
        num Rx;
        num Ry;
        num Rz;
    ENDRECORD

    ! Vision hand-eye calibration records
    RECORD HandEye_Calib_Send_Model
        num Vision_Model;
        num Calibration_Model;
        HPoint ACT_Point;
    ENDRECORD

    RECORD HandEye_Calib_Receive_Model
        string Message_Error;
        num IsStatus;
        HPoint Calib_Point;
    ENDRECORD

    ! Vision model creation records (aligned with T_ROB1 HG_Laser/HG_Vision & PC protocol)
    RECORD Creation_Model_Send_Model
        num Vision_Model;
        num Robot_Type;
        HPoint CameraPos;
        HPoint OriginPos;
    ENDRECORD

    RECORD Creation_Model_Receive_Model
        string Message_Error;
        num IsStatus;
        HPoint Creation_Point;
    ENDRECORD

    ! MES 6-axis joint angles (deg, J1..J6)
    RECORD HG_Mes_RobotAxis_Model
        num J1;
        num J2;
        num J3;
        num J4;
        num J5;
        num J6;
    ENDRECORD

    ! MES status frame payload (defined here so both T_ROB1 and HG_Mes compile cleanly)
    RECORD HG_Mes_SocketSend_Model
        string Robot_Type;
        string Vision_Model;
        string Mes_Robot_Mode;
        string Mes_Programs_Name;
        string Robot_Process_Int;
        string Mes_Work_A_State;
        string Mes_Work_B_State;
        string Mes_Work_C_State;
        string Mes_Work_D_State;
        string Mes_Weld_State;
        bool Has_Robot_Axis;
        HG_Mes_RobotAxis_Model Robot_Axis;
    ENDRECORD

    ! MES PC ACK payload (8 bytes: IsStatus DINT + Socket_Polling_Time DINT)
    RECORD HG_Mes_SocketRece_Model
        num Socket_Polling_Time;
        num IsStatus;
    ENDRECORD

    ! Hand-eye calibration & vision mode constants (merged from Glode_HanGao.sys)
    CONST string HE_Calib_Start_Model:="Calibration_Start";
    CONST string HE_Calib_Progress_Model:="Calibration_Progress";
    CONST string HE_Calib_End_Model:="Calibration_End";
    CONST string HE_Creation_CameraPos_Model:="Creation_CameraPos";
    CONST string HE_Creation_OriginPos_Model:="Creation_OriginPos";

    ! Network configuration (site controller endpoints)
    CONST num HG_Client_PORT:=5400;
    CONST num HG_Mes_Client_PORT:=6000;
    CONST num HG_Sever_PORT:=5001;
    CONST num HG_Client_Time:=2;
    CONST string HG_Sever_IP:="192.168.0.51";
    CONST string HG_Client_IP:="192.168.125.100";

    CONST bool DegLog:=TRUE;

    ! Per-task socket handles (SYS.cfg loads HG_Socket into T_ROB1 and HG_Mes separately)
    VAR socketdev Server;
    VAR socketdev Client;

    PROC HTWrite(string Message)
        IF DegLog THEN
            TPWrite Message;
        ENDIF
    ENDPROC

    ! RW6 & RW7 compatible ASCII packer (avoids legacy ASCII switch removed in RW7)
    LOCAL PROC Pack_Ascii_Text(string text_val,VAR rawbytes raw_buf)
        VAR num text_len;
        VAR byte ch_byte;

        text_len:=StrLen(text_val);
        IF text_len>0 THEN
            FOR ch_idx FROM 1 TO text_len STEP 1 DO
                ch_byte:=StrToByte(StrPart(text_val,ch_idx,1)\Char);
                PackRawBytes ch_byte,raw_buf,(RawBytesLen(raw_buf)+1)\Hex1;
            ENDFOR
        ENDIF
    ENDPROC

    ! Pack UInt16 length-prefixed ASCII field into rawbytes buffer
    LOCAL PROC Pack_Ascii_Field(string text_val,VAR rawbytes raw_buf)
        PackRawBytes StrLen(text_val),raw_buf,(RawBytesLen(raw_buf)+1)\IntX:=UINT;
        Pack_Ascii_Text text_val,raw_buf;
    ENDPROC

    ! RW6 & RW7 compatible ASCII unpacker (caps at RAPID 80-char string max)
    LOCAL PROC Unpack_Ascii_Text(VAR rawbytes raw_buf,num start_pos,num text_len,INOUT string text_out)
        VAR num copy_len;
        VAR byte ch_byte;

        text_out:="";
        copy_len:=text_len;
        IF copy_len<=0 THEN
            RETURN;
        ENDIF
        IF copy_len>80 THEN
            copy_len:=80;
        ENDIF

        FOR ch_idx FROM 1 TO copy_len STEP 1 DO
            UnpackRawBytes raw_buf,start_pos+ch_idx-1,ch_byte\Hex1;
            text_out:=text_out+ByteToStr(ch_byte\Char);
        ENDFOR
    ENDPROC

    PROC HG_Socket_Close(VAR socketdev sock)
        IF SocketGetStatus(sock)<>SOCKET_CLOSED THEN
            SocketClose sock;
        ENDIF
        HTWrite "close socket success, sockStatus = "+ValToStr(SocketGetStatus(sock));

    ERROR
        RETURN;
    ENDPROC

    FUNC bool HG_Socket_Client_Connect(VAR socketdev client_socket,num port,\bool Wait_out,\num wait_time)
        VAR num time_val:=WAIT_MAX;
        VAR bool wait_flag:=FALSE;

        IF Present(wait_time) time_val:=wait_time;
        IF Present(Wait_out) wait_flag:=Wait_out;

        IF SocketGetStatus(client_socket)<>SOCKET_CLOSED THEN
            SocketClose client_socket;
        ENDIF

        SocketCreate client_socket;
        SocketConnect client_socket,HG_Client_IP,port\Time:=time_val;

        IF SocketGetStatus(client_socket)=SOCKET_CONNECTED THEN
            HTWrite "Socket Connect OK->, "+HG_Client_IP+":"+ValToStr(port);
            RETURN TRUE;
        ENDIF

        IF SocketGetStatus(client_socket)<>SOCKET_CLOSED THEN
            SocketClose client_socket;
        ENDIF
        RETURN FALSE;

    ERROR
        IF ERRNO=ERR_SOCK_TIMEOUT THEN
            IF wait_flag THEN
                WaitTime 1;
                RETRY;
            ENDIF
            IF SocketGetStatus(client_socket)<>SOCKET_CLOSED THEN
                SocketClose client_socket;
            ENDIF
            RETURN FALSE;
        ELSEIF ERRNO=ERR_SOCK_CLOSED THEN
            IF SocketGetStatus(client_socket)<>SOCKET_CLOSED THEN
                SocketClose client_socket;
            ENDIF
            RETURN FALSE;
        ELSE
            HTWrite "Socket Connect error, ERRNO = "+ValToStr(ERRNO);
            IF SocketGetStatus(client_socket)<>SOCKET_CLOSED THEN
                SocketClose client_socket;
            ENDIF
            RETURN FALSE;
        ENDIF
    ENDFUNC

    ! Vision model creation entry (merged from Glode_HanGao.sys, called by T_ROB1)
    PROC HG_Creation_Model(wobjdata OriginPos)
        VAR Creation_Model_Send_Model Creation_Model_Send;
        VAR Creation_Model_Receive_Model Creation_Model_Receive;
        VAR robtarget ACT_Point;
        VAR bool Socket_Connect_State;

        ! Vision function code & robot type (1 = ABB)
        Creation_Model_Send.Vision_Model:=6;
        Creation_Model_Send.Robot_Type:=1;

        ACT_Point:=CRobT();

        Creation_Model_Send.CameraPos.x:=ACT_Point.trans.x;
        Creation_Model_Send.CameraPos.y:=ACT_Point.trans.y;
        Creation_Model_Send.CameraPos.z:=ACT_Point.trans.z;
        Creation_Model_Send.CameraPos.Rx:=EulerZYX(\X,ACT_Point.rot);
        Creation_Model_Send.CameraPos.Ry:=EulerZYX(\Y,ACT_Point.rot);
        Creation_Model_Send.CameraPos.Rz:=EulerZYX(\Z,ACT_Point.rot);

        Creation_Model_Send.OriginPos.x:=OriginPos.uframe.trans.x;
        Creation_Model_Send.OriginPos.y:=OriginPos.uframe.trans.y;
        Creation_Model_Send.OriginPos.z:=OriginPos.uframe.trans.z;
        Creation_Model_Send.OriginPos.Rx:=EulerZYX(\X,OriginPos.uframe.rot);
        Creation_Model_Send.OriginPos.Ry:=EulerZYX(\Y,OriginPos.uframe.rot);
        Creation_Model_Send.OriginPos.Rz:=EulerZYX(\Z,OriginPos.uframe.rot);

        HTWrite "CameraPos:"+ValToStr(Creation_Model_Send.CameraPos);
        HTWrite "OriginPos:"+ValToStr(Creation_Model_Send.OriginPos);

        Socket_Connect_State:=HG_Socket_Client_Connect(Client,HG_Client_PORT\Wait_out:=FALSE\wait_time:=2000);
        IF Socket_Connect_State=FALSE THEN
            HTWrite "HG_Creation_Model socket connect failed";
            HG_Socket_Close Client;
            RETURN;
        ENDIF

        HG_Creation_Model_Socket_Send Client,Creation_Model_Send;
        HG_Creation_Model_Socket_Receive Client,Creation_Model_Receive;
        HG_Socket_Close Client;

        IF Creation_Model_Receive.IsStatus=1 THEN
            ! Creation model succeeded
        ENDIF

        HTWrite Creation_Model_Receive.Message_Error;

    ERROR
        HG_Socket_Close Client;
        RAISE;
    ENDPROC

    ! Vision hand-eye calibration entry (merged from Glode_HanGao.sys, called by T_ROB1)
    PROC HG_HandEye_Calib(string Model,\INOUT robtarget Calib_Pos)
        VAR HandEye_Calib_Send_Model HandEye_Send;
        VAR HandEye_Calib_Receive_Model Hand_Recevice;
        VAR robtarget ACT_Point;
        VAR bool Socket_Connect_State;

        HandEye_Send.Vision_Model:=5;

        TEST Model
        CASE HE_Calib_Start_Model:
            HandEye_Send.Calibration_Model:=0;
        CASE HE_Calib_Progress_Model:
            HandEye_Send.Calibration_Model:=1;
            ACT_Point:=CRobT();
            HandEye_Send.ACT_Point.x:=ACT_Point.trans.x;
            HandEye_Send.ACT_Point.y:=ACT_Point.trans.y;
            HandEye_Send.ACT_Point.z:=ACT_Point.trans.z;
            HandEye_Send.ACT_Point.Rx:=EulerZYX(\X,ACT_Point.rot);
            HandEye_Send.ACT_Point.Ry:=EulerZYX(\Y,ACT_Point.rot);
            HandEye_Send.ACT_Point.Rz:=EulerZYX(\Z,ACT_Point.rot);
        CASE HE_Calib_End_Model:
            HandEye_Send.Calibration_Model:=2;
        DEFAULT:
            TPWrite "Model:="+Model+" , Calibtion Val Error! ";
            Stop;
            EXIT;
        ENDTEST

        HTWrite ValToStr(HandEye_Send.ACT_Point);

        Socket_Connect_State:=HG_Socket_Client_Connect(Client,HG_Client_PORT\Wait_out:=FALSE\wait_time:=2000);
        IF Socket_Connect_State=FALSE THEN
            HTWrite "HG_HandEye_Calib socket connect failed";
            HG_Socket_Close Client;
            RETURN;
        ENDIF

        HG_HE_Calib_Socket_Send Client,HandEye_Send;
        HG_HE_Calib_Socket_Receive Client,Hand_Recevice;
        HG_Socket_Close Client;

        IF Hand_Recevice.IsStatus=1 THEN
            TEST Model
            CASE HE_Calib_Start_Model:
                ! Start step acknowledged
            CASE HE_Calib_Progress_Model:
                ! Progress sample acknowledged
            CASE HE_Calib_End_Model:
                Stop\NoRegain;
                IF Present(Calib_Pos) THEN
                    Calib_Pos.trans.x:=Hand_Recevice.Calib_Point.x;
                    Calib_Pos.trans.y:=Hand_Recevice.Calib_Point.y;
                    Calib_Pos.trans.z:=Hand_Recevice.Calib_Point.z;
                ENDIF
            ENDTEST

            HTWrite Hand_Recevice.Message_Error;
        ENDIF

    ERROR
        HG_Socket_Close Client;
        RAISE;
    ENDPROC

    FUNC HandEye_Calib_Receive_Model HG_Receive_ToModel(byte Receive_Byte)
        VAR HandEye_Calib_Receive_Model Receive_Model;
        VAR string Receice_str;

        Receice_str:=ByteToStr(Receive_Byte);
        HTWrite Receice_str;

        RETURN Receive_Model;
    ENDFUNC

    PROC HG_Creation_Model_Socket_Send(VAR socketdev client_socket,VAR Creation_Model_Send_Model Send_Model)
        VAR rawbytes Data_raw;
        VAR rawbytes Send_raw;

        ClearRawBytes Data_raw;
        ClearRawBytes Send_raw;

        PackRawBytes Send_Model.Vision_Model,Send_raw,(RawBytesLen(Send_raw)+1)\IntX:=INT;
        PackRawBytes Send_Model.Robot_Type,Send_raw,(RawBytesLen(Send_raw)+1)\IntX:=INT;
        PackRawBytes Send_Model.CameraPos.x,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.CameraPos.y,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.CameraPos.z,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.CameraPos.Rx,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.CameraPos.Ry,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.CameraPos.Rz,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.OriginPos.x,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.OriginPos.y,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.OriginPos.z,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.OriginPos.Rx,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.OriginPos.Ry,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.OriginPos.Rz,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;

        PackRawBytes RawBytesLen(Send_raw),Data_raw,1\IntX:=INT;
        CopyRawBytes Send_raw,1,Data_raw,3;

        SocketSend client_socket\RawData:=Data_raw;

    ERROR
        IF ERRNO=ERR_SOCK_TIMEOUT THEN
            HTWrite "pack msg to sensor socket timeout";
        ELSEIF ERRNO=ERR_SOCK_CLOSED THEN
            HTWrite "pack msg to sensor socket closed";
        ELSE
            HTWrite "pack msg to sensor socket unknown";
        ENDIF
        RAISE;
    ENDPROC

    PROC HG_Creation_Model_Socket_Receive(VAR socketdev client_socket,VAR Creation_Model_Receive_Model Rece_Model,\num Wait_Time)
        VAR num time_val:=WAIT_MAX;
        VAR num msg_len:=0;
        VAR num bytes_rcvd:=0;
        VAR num Error_Length:=0;
        VAR rawbytes Rece_raw;

        Rece_Model.IsStatus:=0;
        Rece_Model.Message_Error:="";
        ClearRawBytes Rece_raw;
        IF Present(Wait_Time) time_val:=Wait_Time;

        ! Receive 4-byte message length
        SocketReceive client_socket\RawData:=Rece_raw\ReadNoOfBytes:=4\Time:=time_val;
        UnpackRawBytes Rece_raw,1,msg_len\IntX:=DINT;
        IF (msg_len<=0) OR (msg_len>1024) THEN
            Rece_Model.IsStatus:=0;
            RETURN;
        ENDIF

        ClearRawBytes Rece_raw;
        SocketReceive client_socket\RawData:=Rece_raw\ReadNoOfBytes:=msg_len\NoRecBytes:=bytes_rcvd\Time:=time_val;
        IF bytes_rcvd<>msg_len THEN
            ErrWrite\W,"ROS Socket Recv Failed","Did not receive expected # of bytes.",
                     \RL2:="Expected: "+ValToStr(msg_len),
                     \RL3:="Received: "+ValToStr(bytes_rcvd);
            Rece_Model.IsStatus:=0;
            RETURN;
        ENDIF

        IF msg_len<32 THEN
            Rece_Model.IsStatus:=0;
            RETURN;
        ENDIF

        UnpackRawBytes Rece_raw,1,Rece_Model.IsStatus\IntX:=DINT;
        UnpackRawBytes Rece_raw,5,Error_Length\IntX:=DINT;
        IF (Error_Length<0) OR ((Error_Length+32)>msg_len) THEN
            Rece_Model.IsStatus:=0;
            RETURN;
        ENDIF
        Unpack_Ascii_Text Rece_raw,9,Error_Length,Rece_Model.Message_Error;
        UnpackRawBytes Rece_raw,Error_Length+9,Rece_Model.Creation_Point.x\Float4;
        UnpackRawBytes Rece_raw,Error_Length+13,Rece_Model.Creation_Point.y\Float4;
        UnpackRawBytes Rece_raw,Error_Length+17,Rece_Model.Creation_Point.z\Float4;
        UnpackRawBytes Rece_raw,Error_Length+21,Rece_Model.Creation_Point.Rx\Float4;
        UnpackRawBytes Rece_raw,Error_Length+25,Rece_Model.Creation_Point.Ry\Float4;
        UnpackRawBytes Rece_raw,Error_Length+29,Rece_Model.Creation_Point.Rz\Float4;

        IF Rece_Model.IsStatus=0 THEN
            ErrWrite\W,"Creation Model Error!",Rece_Model.Message_Error;
        ENDIF

    ERROR
        IF ERRNO=ERR_SOCK_TIMEOUT THEN
            TPWrite "unpack msg from sensor socket timeout, timeout time is: "+ValToStr(time_val);
        ELSEIF ERRNO=ERR_SOCK_CLOSED THEN
            TPWrite "unpack msg from sensor socket closed";
        ELSE
            TPWrite "unpack msg from sensor socket unknown";
        ENDIF
        Rece_Model.IsStatus:=0;
        RETURN;
    ENDPROC

    PROC HG_HE_Calib_Socket_Send(VAR socketdev client_socket,VAR HandEye_Calib_Send_Model Send_Model)
        VAR rawbytes Send_raw;

        ClearRawBytes Send_raw;

        Pack_Ascii_Text "[",Send_raw;
        PackRawBytes Send_Model.Vision_Model,Send_raw,(RawBytesLen(Send_raw)+1)\IntX:=DINT;
        PackRawBytes Send_Model.Calibration_Model,Send_raw,(RawBytesLen(Send_raw)+1)\IntX:=DINT;
        PackRawBytes Send_Model.ACT_Point.x,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.ACT_Point.y,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.ACT_Point.z,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.ACT_Point.Rx,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.ACT_Point.Ry,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        PackRawBytes Send_Model.ACT_Point.Rz,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        Pack_Ascii_Text "]",Send_raw;

        SocketSend client_socket\RawData:=Send_raw;

    ERROR
        IF ERRNO=ERR_SOCK_TIMEOUT THEN
            HTWrite "pack msg to sensor socket timeout";
        ELSEIF ERRNO=ERR_SOCK_CLOSED THEN
            HTWrite "pack msg to sensor socket closed";
        ELSE
            HTWrite "pack msg to sensor socket unknown";
        ENDIF
        RAISE;
    ENDPROC

    PROC HG_HE_Calib_Socket_Receive(VAR socketdev client_socket,VAR HandEye_Calib_Receive_Model Rece_Model,\num Wait_Time)
        VAR num time_val:=WAIT_MAX;
        VAR num msg_len:=0;
        VAR num bytes_rcvd:=0;
        VAR num Error_Length:=0;
        VAR rawbytes Rece_raw;

        Rece_Model.IsStatus:=0;
        Rece_Model.Message_Error:="";
        ClearRawBytes Rece_raw;
        IF Present(Wait_Time) time_val:=Wait_Time;

        ! Receive 4-byte message length
        SocketReceive client_socket\RawData:=Rece_raw\ReadNoOfBytes:=4\Time:=time_val;
        UnpackRawBytes Rece_raw,1,msg_len\IntX:=DINT;
        IF (msg_len<=0) OR (msg_len>1024) THEN
            Rece_Model.IsStatus:=0;
            RETURN;
        ENDIF

        ClearRawBytes Rece_raw;
        SocketReceive client_socket\RawData:=Rece_raw\ReadNoOfBytes:=msg_len\NoRecBytes:=bytes_rcvd\Time:=time_val;
        IF bytes_rcvd<>msg_len THEN
            ErrWrite\W,"ROS Socket Recv Failed","Did not receive expected # of bytes.",
                     \RL2:="Expected: "+ValToStr(msg_len),
                     \RL3:="Received: "+ValToStr(bytes_rcvd);
            Rece_Model.IsStatus:=0;
            RETURN;
        ENDIF

        IF msg_len<32 THEN
            Rece_Model.IsStatus:=0;
            RETURN;
        ENDIF

        UnpackRawBytes Rece_raw,1,Rece_Model.IsStatus\IntX:=DINT;
        UnpackRawBytes Rece_raw,5,Error_Length\IntX:=DINT;
        IF (Error_Length<0) OR ((Error_Length+32)>msg_len) THEN
            Rece_Model.IsStatus:=0;
            RETURN;
        ENDIF
        Unpack_Ascii_Text Rece_raw,9,Error_Length,Rece_Model.Message_Error;
        UnpackRawBytes Rece_raw,Error_Length+9,Rece_Model.Calib_Point.x\Float4;
        UnpackRawBytes Rece_raw,Error_Length+13,Rece_Model.Calib_Point.y\Float4;
        UnpackRawBytes Rece_raw,Error_Length+17,Rece_Model.Calib_Point.z\Float4;
        UnpackRawBytes Rece_raw,Error_Length+21,Rece_Model.Calib_Point.Rx\Float4;
        UnpackRawBytes Rece_raw,Error_Length+25,Rece_Model.Calib_Point.Ry\Float4;
        UnpackRawBytes Rece_raw,Error_Length+29,Rece_Model.Calib_Point.Rz\Float4;

        IF Rece_Model.IsStatus=0 THEN
            ErrWrite\W,"HandEye Calibration Error!",Rece_Model.Message_Error;
        ENDIF

    ERROR
        IF ERRNO=ERR_SOCK_TIMEOUT THEN
            TPWrite "unpack msg from sensor socket timeout, timeout time is: "+ValToStr(time_val);
        ELSEIF ERRNO=ERR_SOCK_CLOSED THEN
            TPWrite "unpack msg from sensor socket closed";
        ELSE
            TPWrite "unpack msg from sensor socket unknown";
        ENDIF
        Rece_Model.IsStatus:=0;
        RETURN;
    ENDPROC

    ! Drain stale receive bytes before sending next MES frame
    PROC Mes_Socket_Clear_Receive(VAR socketdev client_socket)
        VAR num pending_bytes;
        VAR num read_bytes;
        VAR rawbytes drain_raw;

        IF SocketGetStatus(client_socket)<>SOCKET_CONNECTED THEN
            RETURN;
        ENDIF

        pending_bytes:=SocketPeek(client_socket);
        WHILE pending_bytes>0 DO
            read_bytes:=pending_bytes;
            IF read_bytes>1024 THEN
                read_bytes:=1024;
            ENDIF
            ClearRawBytes drain_raw;
            SocketReceive client_socket\RawData:=drain_raw\ReadNoOfBytes:=read_bytes\Time:=0.2;
            pending_bytes:=SocketPeek(client_socket);
        ENDWHILE

    ERROR
        IF ERRNO=ERR_SOCK_TIMEOUT THEN
            RETURN;
        ELSE
            RAISE;
        ENDIF
    ENDPROC

    ! Pack MES binary frame:
    ! [UInt16 TotalLen][Fields 1..9 ASCII][Field 10 Mes_Weld_State ASCII][Optional 6xFloat4 J1..J6]
    PROC Mes_Socket_Info_Send(VAR socketdev client_socket,VAR HG_Mes_SocketSend_Model Send_Model)
        VAR rawbytes Data_raw;
        VAR rawbytes Send_raw;

        ClearRawBytes Data_raw;
        ClearRawBytes Send_raw;

        ! Legacy 9 ASCII fields (UInt16 length + ASCII bytes)
        Pack_Ascii_Field Send_Model.Vision_Model,Send_raw;
        Pack_Ascii_Field Send_Model.Robot_Type,Send_raw;
        Pack_Ascii_Field Send_Model.Mes_Robot_Mode,Send_raw;
        Pack_Ascii_Field Send_Model.Mes_Programs_Name,Send_raw;
        Pack_Ascii_Field Send_Model.Mes_Work_A_State,Send_raw;
        Pack_Ascii_Field Send_Model.Mes_Work_B_State,Send_raw;
        Pack_Ascii_Field Send_Model.Mes_Work_C_State,Send_raw;
        Pack_Ascii_Field Send_Model.Mes_Work_D_State,Send_raw;
        Pack_Ascii_Field Send_Model.Robot_Process_Int,Send_raw;

        ! Extended field 10: laser/weld output state ("TRUE" / "FALSE")
        Pack_Ascii_Field Send_Model.Mes_Weld_State,Send_raw;

        ! Extended field 11: optional J1..J6 IEEE-754 Float4 LE (24 bytes)
        IF Send_Model.Has_Robot_Axis THEN
            PackRawBytes Send_Model.Robot_Axis.J1,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
            PackRawBytes Send_Model.Robot_Axis.J2,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
            PackRawBytes Send_Model.Robot_Axis.J3,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
            PackRawBytes Send_Model.Robot_Axis.J4,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
            PackRawBytes Send_Model.Robot_Axis.J5,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
            PackRawBytes Send_Model.Robot_Axis.J6,Send_raw,(RawBytesLen(Send_raw)+1)\Float4;
        ENDIF

        ! Prefix total frame length (including this 2-byte UINT header)
        PackRawBytes RawBytesLen(Send_raw)+2,Data_raw,1\IntX:=UINT;
        CopyRawBytes Send_raw,1,Data_raw,3;

        SocketSend client_socket\RawData:=Data_raw;

    ERROR
        IF ERRNO=ERR_SOCK_TIMEOUT THEN
            HTWrite "MES socket send timeout";
        ELSEIF ERRNO=ERR_SOCK_CLOSED THEN
            HTWrite "MES socket send closed";
        ELSE
            HTWrite "MES socket send error, ERRNO = "+ValToStr(ERRNO);
        ENDIF
        RAISE;
    ENDPROC

    ! Receive fixed 8-byte MES ACK: [IsStatus DINT LE][Socket_Polling_Time DINT LE]
    PROC Mes_Socket_Info_Receive(VAR socketdev client_socket,VAR HG_Mes_SocketRece_Model Rece_Model,\num Wait_Time)
        VAR num time_val:=WAIT_MAX;
        VAR num bytes_rcvd:=0;
        VAR rawbytes Rece_raw;

        Rece_Model.IsStatus:=0;
        Rece_Model.Socket_Polling_Time:=0;
        IF Present(Wait_Time) time_val:=Wait_Time;

        ClearRawBytes Rece_raw;
        SocketReceive client_socket\RawData:=Rece_raw\ReadNoOfBytes:=8\NoRecBytes:=bytes_rcvd\Time:=time_val;

        IF bytes_rcvd<>8 THEN
            HTWrite "MES ACK invalid byte count: "+ValToStr(bytes_rcvd);
            Rece_Model.IsStatus:=0;
            RETURN;
        ENDIF

        UnpackRawBytes Rece_raw,1,Rece_Model.IsStatus\IntX:=DINT;
        UnpackRawBytes Rece_raw,5,Rece_Model.Socket_Polling_Time\IntX:=DINT;
        ClearRawBytes Rece_raw;

    ERROR
        IF ERRNO=ERR_SOCK_TIMEOUT THEN
            HTWrite "MES ACK socket timeout, timeout = "+ValToStr(time_val);
        ELSEIF ERRNO=ERR_SOCK_CLOSED THEN
            HTWrite "MES ACK socket closed";
        ELSE
            HTWrite "MES ACK socket error, ERRNO = "+ValToStr(ERRNO);
        ENDIF
        Rece_Model.IsStatus:=0;
        RETURN;
    ENDPROC

ENDMODULE
