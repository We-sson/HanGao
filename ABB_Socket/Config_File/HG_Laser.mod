    PROC Set_LaserData(inout welddata data,num Power,num Speed)
        !Set Weldata
        IF Power>100 THEN
            Power:=100;
        ELSEIF Power<0 THEN
            Power:=0;
        ENDIF
        Power:=Power/10;
        data.main_arc.voltage:=Power;
        data.weld_speed:=Speed;
        data.org_weld_speed:=Speed;
        data.org_arc.voltage:=Power;
        !data:=[Speed,Speed,[0,0,Power,0,0,0,0,0,0],[0,0,Power,0,0,0,0,0,0]];
    ENDPROC







