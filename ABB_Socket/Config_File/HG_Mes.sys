MODULE HG_Mes(SYSMODULE)

    ! Process code reported to MES (site value: R_Side_9)
    CONST string Robot_Process_Name:="R_Side_9";
    CONST string Mes_Info_Data:="Mes_Info_Data";

    ! Fallback motion task name when HG_Mes runs as a non-motion background task
    CONST string HG_Mes_Motion_Task:="T_ROB1";
    CONST num Mes_Reconnect_Wait_Time:=1;
    CONST num Mes_Loop_Wait_Time:=0.02;

    PERS num Work_A_Run_Nunber:=0;
    PERS num Work_B_Run_Nunber:=0;
    PERS num Work_C_Run_Nunber:=0;
    PERS num Work_D_Run_Nunber:=0;

    LOCAL VAR bool Q_Work_A_Stat:=FALSE;
    LOCAL VAR bool Q_Work_B_Stat:=FALSE;
    LOCAL VAR bool Q_Work_C_Stat:=FALSE;
    LOCAL VAR bool Q_Work_D_Stat:=FALSE;
    VAR bool EKRL_Connect_Stat:=FALSE;
    VAR bool EKRL_Send_Stat:=FALSE;
    VAR bool EKRL_Server_Stat:=FALSE;

    ! Cross-task PERS station states owned by T_ROB1 MainModule.mod (read-only here)
    PERS bool Work_A_state:=FALSE;
    PERS bool Work_B_state:=FALSE;
    PERS bool Work_C_state:=FALSE;
    PERS bool Work_D_state:=FALSE;

    VAR num Socket_TimeOut:=5;
    VAR clock Socket_Cycle_clock;

    PROC Main()
        HG_Mes_Info_Main;
    ENDPROC

    PROC HG_Mes_Info_Main()
        HG_Mes_Info_Int;

        WHILE TRUE DO
            HG_Mes_Date_Send EKRL_Connect_Stat,EKRL_Send_Stat;
            WaitTime Mes_Loop_Wait_Time;
        ENDWHILE

    UNDO
        IF SocketGetStatus(Client)<>SOCKET_CLOSED THEN
            SocketClose Client;
        ENDIF
        EKRL_Connect_Stat:=FALSE;
        EKRL_Send_Stat:=FALSE;
    ENDPROC

    PROC HG_Mes_Info_Int()
        Q_Work_A_Stat:=FALSE;
        Q_Work_B_Stat:=FALSE;
        Q_Work_C_Stat:=FALSE;
        Q_Work_D_Stat:=FALSE;
        EKRL_Send_Stat:=FALSE;
        EKRL_Connect_Stat:=FALSE;
        EKRL_Server_Stat:=FALSE;

        ! Close any leftover socket handle; do NOT reset Work_*_state owned by T_ROB1
        HG_Socket_Close Client;
    ENDPROC

    ! Read live J1..J6 joint angles from foreground motion task (T_ROB1)
    LOCAL FUNC bool HG_Mes_Read_Joints(string motion_task_name,INOUT HG_Mes_RobotAxis_Model axis_out)
        VAR jointtarget act_joints;
        VAR string target_task;

        axis_out:=[0,0,0,0,0,0];
        IF TaskRunMec() THEN
            act_joints:=CJointT();
        ELSE
            target_task:=motion_task_name;
            IF StrLen(target_task)=0 THEN
                target_task:=HG_Mes_Motion_Task;
            ENDIF
            act_joints:=CJointT(\TaskName:=target_task);
        ENDIF

        ! Reject unconfigured/invalid ABB 9E+09 sentinel values
        IF (Abs(act_joints.robax.rax_1)>=9E8) OR (Abs(act_joints.robax.rax_2)>=9E8) OR (Abs(act_joints.robax.rax_3)>=9E8) THEN
            RETURN FALSE;
        ENDIF
        IF (Abs(act_joints.robax.rax_4)>=9E8) OR (Abs(act_joints.robax.rax_5)>=9E8) OR (Abs(act_joints.robax.rax_6)>=9E8) THEN
            RETURN FALSE;
        ENDIF

        axis_out.J1:=act_joints.robax.rax_1;
        axis_out.J2:=act_joints.robax.rax_2;
        axis_out.J3:=act_joints.robax.rax_3;
        axis_out.J4:=act_joints.robax.rax_4;
        axis_out.J5:=act_joints.robax.rax_5;
        axis_out.J6:=act_joints.robax.rax_6;
        RETURN TRUE;

    ERROR
        axis_out:=[0,0,0,0,0,0];
        RETURN FALSE;
    ENDFUNC

    PROC HG_Mes_Date_Send(VAR bool Connt_Stat,VAR bool Send_Stat)
        ! Connect to MES server when offline
        IF Connt_Stat=FALSE THEN
            Connt_Stat:=HG_Socket_Client_Connect(Client,HG_Mes_Client_PORT\Wait_out:=FALSE\wait_time:=Socket_TimeOut);
            IF Connt_Stat=TRUE THEN
                Send_Stat:=TRUE;
            ELSE
                WaitTime Mes_Reconnect_Wait_Time;
                RETURN;
            ENDIF
        ENDIF

        ! Drain stale bytes before sending the next frame
        IF SocketGetStatus(Client)=SOCKET_CONNECTED THEN
            Mes_Socket_Clear_Receive Client;
        ENDIF

        ! Send MES snapshot and wait for 8-byte ACK
        IF (Connt_Stat=TRUE) AND (Send_Stat=TRUE) AND (SocketGetStatus(Client)=SOCKET_CONNECTED) THEN
            HG_Mes_Info_Send Send_Stat;
        ENDIF

        ! Close and wait before reconnecting when disconnected or ACK failed
        IF ((Connt_Stat=TRUE) AND (SocketGetStatus(Client)<>SOCKET_CONNECTED)) OR (Send_Stat=FALSE) THEN
            HG_Socket_Close Client;
            Connt_Stat:=FALSE;
            Send_Stat:=FALSE;
            WaitTime Mes_Reconnect_Wait_Time;
        ENDIF

    ERROR
        HG_Socket_Close Client;
        Connt_Stat:=FALSE;
        Send_Stat:=FALSE;
        WaitTime Mes_Reconnect_Wait_Time;
        RETURN;
    ENDPROC

    PROC HG_Mes_Info_Send(VAR bool Send_Stat)
        VAR HG_Mes_SocketSend_Model HG_Mes_SocketSend;
        VAR HG_Mes_SocketRece_Model HG_Mes_SocketRece;
        VAR num No:=0;
        VAR string motion_task_name:="";

        HG_Mes_SocketRece.IsStatus:=0;
        HG_Mes_SocketRece.Socket_Polling_Time:=0;

        HG_Mes_SocketSend.Robot_Type:="ABB";
        HG_Mes_SocketSend.Vision_Model:=Mes_Info_Data;

        motion_task_name:=GetTaskName(\MecTaskNo:=No);
        IF StrLen(motion_task_name)=0 THEN
            motion_task_name:=HG_Mes_Motion_Task;
        ENDIF
        HG_Mes_SocketSend.Mes_Programs_Name:=motion_task_name;

        ! Real controller status signals (EIO.cfg: DNDO05_Error, DNDO06_Run_LED)
        IF DNDO05_Error=1 THEN
            HG_Mes_SocketSend.Mes_Robot_Mode:="Error";
        ELSE
            IF (DNDO06_Run_LED=1) AND (OpMode()=OP_AUTO) THEN
                HG_Mes_SocketSend.Mes_Robot_Mode:="Run";
            ELSE
                HG_Mes_SocketSend.Mes_Robot_Mode:="T1";
            ENDIF
        ENDIF

        HG_Mes_SocketSend.Mes_Work_A_State:=ValToStr(Work_A_state);
        HG_Mes_SocketSend.Mes_Work_B_State:=ValToStr(Work_B_state);
        HG_Mes_SocketSend.Mes_Work_C_State:=ValToStr(Work_C_state);
        HG_Mes_SocketSend.Mes_Work_D_State:=ValToStr(Work_D_state);

        HG_Mes_SocketSend.Robot_Process_Int:=Robot_Process_Name;

        ! Real ArcWare WeldOn laser output signal (PROC.cfg: -WeldOn "DNDO00_Laser")
        IF DNDO00_Laser=1 THEN
            HG_Mes_SocketSend.Mes_Weld_State:="TRUE";
        ELSE
            HG_Mes_SocketSend.Mes_Weld_State:="FALSE";
        ENDIF

        ! Live 6-axis angles for 3D digital twin (omitted safely if unreadable)
        HG_Mes_SocketSend.Has_Robot_Axis:=HG_Mes_Read_Joints(motion_task_name,HG_Mes_SocketSend.Robot_Axis);

        Mes_Socket_Info_Send Client,HG_Mes_SocketSend;
        Mes_Socket_Info_Receive Client,HG_Mes_SocketRece\Wait_Time:=Socket_TimeOut;

        IF HG_Mes_SocketRece.IsStatus=1 THEN
            Send_Stat:=TRUE;
        ELSE
            Send_Stat:=FALSE;
        ENDIF

    ERROR
        IF ERRNO=ERR_SOCK_TIMEOUT THEN
            HTWrite "MES exchange timeout, timeout = "+ValToStr(Socket_TimeOut);
        ELSEIF ERRNO=ERR_SOCK_CLOSED THEN
            HTWrite "MES exchange socket closed";
        ELSE
            HTWrite "MES exchange error, ERRNO = "+ValToStr(ERRNO);
        ENDIF
        Send_Stat:=FALSE;
        RETURN;
    ENDPROC

ENDMODULE
