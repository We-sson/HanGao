<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RobotSimulator.AnyCAD.Controls\RobotSimulator.AnyCAD.Controls.csproj" />
  </ItemGroup>
  <Target Name="CopyAnyCadRuntime" AfterTargets="Build">
    <PropertyGroup>
      <RobotSimulatorOutput>$(MSBuildThisFileDirectory)..\..\RobotSimulator.AnyCAD\bin\$(Configuration)\net10.0-windows\win-x64\</RobotSimulatorOutput>
    </PropertyGroup>
    <ItemGroup>
      <AnyCadRuntime Include="$(RobotSimulatorOutput)AnyCAD*.dll;$(RobotSimulatorOutput)TK*.dll;$(RobotSimulatorOutput)Ifc*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AnyCadRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
