<Window
    x:Class="Robot_Info_Mes.Server_Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Enum_Converter="clr-namespace:Robot_Info_Mes.View"
    xmlns:Robot="clr-namespace:Roboto_Socket_Library.Model;assembly=Roboto_Socket_Library"
    xmlns:View="clr-namespace:Robot_Info_Mes.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Robot_Info_Mes"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Window_Version, StringFormat={}生产二楼机械手信息看板 V{0}}"
    MinWidth="1440"
    MinHeight="900"
    d:Height="1080"
    d:Width="1920"
    DataContext="{Binding Robot_Info_VM, Source={StaticResource ViewModelLocator}}"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Window.Resources>
        <Enum_Converter:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </Window.Resources>

    <Grid Background="{DynamicResource 全局_背景_白颜色}">
        <Grid.ColumnDefinitions>

            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <!--<RowDefinition Height=" 380" />-->
            <RowDefinition Height=" *" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="20,0,20,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource 全局_图标库}"
            FontSize="32"
            Foreground="{DynamicResource 全局_按钮_蓝颜色}"
            Text="&#xe641;" />
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="20,0,20,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource 全局_图标库}"
            FontSize="32"
            Foreground="{DynamicResource 全局_按钮_蓝颜色}"
            Text="&#xe641;" />
        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource 全局_文字_中文字体}"
            FontSize="32"
            Foreground="{DynamicResource 全局_按钮_蓝颜色}"
            Text="{Binding Mes_Server_Info_Data.File_Update_Time, StringFormat={}{0:yyyy年M月}三厂二楼机械手OEE看板, ConverterCulture=zh-CN}" />






        <ListBox
            Grid.Row=" 3"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            d:ItemsSource="{d:SampleData ItemCount=3}"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{DynamicResource ListBoxItemStyle1}"
            ItemsSource="{Binding Mes_Server_Info_Data.Mes_Server_Model_List}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            ScrollViewer.IsDeferredScrollingEnabled="True"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding Mes_Server_Model_Select}"
            VirtualizingPanel.IsVirtualizing="False">
            <ListBox.Resources>
                <Style BasedOn="{StaticResource Right_ScrollBarStyle}" TargetType="{x:Type ScrollBar}" />
            </ListBox.Resources>
            <ListBox.ItemTemplate>
                <DataTemplate>


                    <Grid>
                        <View:OEE_UI DataContext="{Binding}" />
                    </Grid>


                </DataTemplate>
            </ListBox.ItemTemplate>

            <i:Interaction.Triggers>

                <i:EventTrigger EventName="Loaded">
                    <i:InvokeCommandAction
                        Command="{Binding Server_Window_Scrolling_Comm}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=EventArgsConverter}"
                        PassEventArgsToCommand="True" />
                </i:EventTrigger>
            </i:Interaction.Triggers>


        </ListBox>



    </Grid>
</Window>
