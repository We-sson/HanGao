                                        BorderThickness="2"
                                        FontFamily="{DynamicResource 全局_文字_数字字体}"
                                        FontSize="18"
                                        Style="{DynamicResource Vision_TextBoxStyle}"
                                        Text="{Binding File_Int_Parameters.Mes_Run_Parameters.Sever_Socket_Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>-->
            </ScrollViewer>
        </Border>

        <!--  页脚：左侧实时启停机器人监听，右侧把全部配置原子保存到 XML。  -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource 全局_按钮_白颜色}"
            BorderBrush="{DynamicResource 全局_背景_蓝颜色}"
            BorderThickness="3,0,3,3"
            CornerRadius=" 0 0 12 12">
            <Grid Margin="22,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    Width="100"
                    Height="36"
                    d:IsChecked="True"
                    Background="{DynamicResource 全局_按钮_蓝颜色}"
                    IsChecked="{Binding Robot_Info_Parameters.Sever_IsRuning}"
                    Style="{DynamicResource CheckBoxStyle1}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource 全局_按钮_白颜色}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="开启服务" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Robot_Info_Parameters.Sever_IsRuning}" Value="True">
                                        <Setter Property="Text" Value="关闭服务" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:InvokeCommandAction
                                Command="{Binding Server_End_Comm}"
                                CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=EventArgsConverter}"
                                PassEventArgsToCommand="True" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </CheckBox>

                <TextBlock
                    Grid.Column="1"
                    Margin="18,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#8793A2"
                    Text="参数调整后点击保存，重启软件后生效" />

                <Button
                    Grid.Column="2"
                    Width="102"
                    Height="36"
                    Background="{DynamicResource 全局_按钮_蓝颜色}"
                    Style="{DynamicResource Halcon_Window_Button}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="保存参数" />
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:InvokeCommandAction
                                Command="{Binding Save_Date_File_Comm}"
                                CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=EventArgsConverter}"
                                PassEventArgsToCommand="True" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </Grid>
        </Border>
    </Grid>

</UserControl>

