                        <Slider
                            x:Name="Mes_Server_Info_Rece_Time_UI"
                            Grid.Column=" 1"
                            Margin="5"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsSnapToTickEnabled="True"
                            Maximum="10"
                            Minimum="0.1"
                            SmallChange="0.1"
                            Style="{DynamicResource Vision_SliderStyle}"
                            TickFrequency="0.1"
                            Value="{Binding File_Int_Parameters.Mes_Run_Parameters.Mes_Server_Info_Rece_Time}" />

                        <TextBox
                            Grid.Column=" 2"
                            Width=" 200"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource 全局_按钮_黑颜色}"
                            BorderThickness="2"
                            FontFamily="{DynamicResource 全局_文字_数字字体}"
                            FontSize="18"
                            Style="{DynamicResource Vision_TextBoxStyle}"
                            Text="{Binding ElementName=Mes_Server_Info_Rece_Time_UI, Path=Value, Mode=TwoWay, StringFormat={}{0:F1}}" />

                        <TextBlock
                            Grid.Column=" 3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="16"
                            Foreground="{DynamicResource 全局_按钮_黑颜色}"
                            Text="秒" />
                    </Grid>


                    <Grid Height=" 35" Margin="0,8,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition />
                            <ColumnDefinition Width=" 30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column=" 0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="16"
                            Foreground="{DynamicResource 全局_按钮_黑颜色}"
                            Text="本机IP" />
                        <!--  启动时枚举的本机 IPv4 列表；程序实际会逐地址创建机器人监听器。  -->
                        <ComboBox
                            Grid.Column=" 1"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            BorderBrush="{DynamicResource 全局_按钮_黑颜色}"
                            BorderThickness="2"
                            IsDropDownOpen="False"
                            IsSynchronizedWithCurrentItem="True"
                            ItemsSource="{Binding Robot_Info_Parameters.Local_IP_UI}"
                            SelectedValue="{}"
                            Style="{DynamicResource Data_ComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="0,4,0,4"
                                        FontFamily="{DynamicResource 全局_文字_数字字体}"
                                        FontSize="16"
                                        Foreground="{DynamicResource 全局_按钮_黑颜色}"
                                        Text="{Binding}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                            <i:Interaction.Triggers>

                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction
                                        Command="{Binding}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=EventArgsConverter}"
                                        PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>


                        </ComboBox>
                    </Grid>
                    <Grid Height="35" Margin="0,8,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                            <ColumnDefinition Width=" auto" />
                            <ColumnDefinition Width=" 30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="16"
                            Foreground="{DynamicResource 全局_按钮_黑颜色}"
                            Text="服务端口" />
                        <!--  机器人控制器主动连接本采集端时使用的监听端口。  -->


                        <TextBox
                            Grid.Column=" 2"
                            Width=" 200"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource 全局_按钮_黑颜色}"
                            BorderThickness="2"
                            FontFamily="{DynamicResource 全局_文字_数字字体}"
                            FontSize="18"
                            Style="{DynamicResource Vision_TextBoxStyle}"
                            Text="{Binding File_Int_Parameters.Mes_Run_Parameters.Sever_Socket_Port, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>




                </StackPanel>


