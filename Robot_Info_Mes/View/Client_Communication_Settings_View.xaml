<UserControl
    x:Class="Robot_Info_Mes.View.Client_Communication_Settings_View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Enum_Converter="clr-namespace:Robot_Info_Mes.View"
    xmlns:Robot="clr-namespace:Roboto_Socket_Library.Model;assembly=Roboto_Socket_Library"
    xmlns:ViewModel="clr-namespace:Robot_Info_Mes.ViewModel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=ViewModel:Robot_Info_VM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">



    <Grid Width=" 500">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!--  标题区：说明本页同时控制机器人监听与 Client→看板的上报链路。  -->
        <Border
            Panel.ZIndex="1"
            Background="{DynamicResource 全局_按钮_白颜色}"
            BorderBrush="{DynamicResource 全局_背景_蓝颜色}"
            BorderThickness="3,3,3,0"
            CornerRadius="12 12 0 0"
            Effect="{DynamicResource 全局背景阴影}">
            <Grid Margin="22,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="#344F6D"
                        Text="通信设置" />
                    <TextBlock
                        Margin="18,3,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="13"
                        Foreground="#8793A2"
                        Text="机器人协议、看板连接和本机服务参数" />
                </StackPanel>

            </Grid>
        </Border>

        <!--  当前生效的纵向表单；所有编辑值直接双向绑定 File_Int_Parameters。  -->

        <Border
            Grid.Row="1"
            BorderBrush="{DynamicResource 全局_背景_蓝颜色}"
            BorderThickness="3,0,3,0">

            <ScrollViewer
                Background="{DynamicResource 全局_背景_灰白颜色}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">


                <StackPanel Margin="10" Orientation="Vertical">
                    <!--  协议类型决定 Socket 库采用 KUKA、ABB、FANUC 或 Kawasaki 的编解码规则。  -->



                    <Grid Height=" 35" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition />
                            <ColumnDefinition Width=" auto" />
                            <ColumnDefinition Width=" 30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column=" 0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="16"
                            Foreground="{DynamicResource 全局_按钮_黑颜色}"
                            Text="机器类型" />
                        <ComboBox
                            Grid.Column=" 1"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="16"
                            IsDropDownOpen="False"
                            IsSynchronizedWithCurrentItem="True"
                            ItemsSource="{Enum_Converter:EnumBindingSource Robot:Socket_Robot_Protocols_Enum}"
                            SelectedValue="{Binding File_Int_Parameters.Mes_Run_Parameters.Socket_Robot_Model}">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource Data_ComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding Robot_Info_Parameters.Sever_IsRuning}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="0,4,0,4"
                                        FontFamily="{DynamicResource 全局_文字_数字字体}"
                                        FontSize="14"
                                        Foreground="{DynamicResource 全局_按钮_黑颜色}"
                                        Text="{Binding}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />


                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>


                    </Grid>



                    <Grid Height="35" Margin="0,8,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                            <ColumnDefinition Width=" auto" />
                            <ColumnDefinition Width=" 30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="16"
                            Foreground="{DynamicResource 全局_按钮_黑颜色}"
                            Text="保存时间" />
                        <!--  Slider 与 TextBox 互相绑定同一数值：本地统计及 XML 快照保存周期。  -->
                        <Slider
                            x:Name="Polling_Time_UI"
                            Grid.Column=" 1"
                            Margin="5"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsSnapToTickEnabled="True"
                            Maximum="10"
                            Minimum="0.1"
                            SmallChange="0.1"
                            Style="{DynamicResource Vision_SliderStyle}"
                            TickFrequency="0.1"
                            Value="{Binding File_Int_Parameters.Mes_Run_Parameters.File_Save_Cycle_Time}" />

                        <TextBox
                            Grid.Column=" 2"
                            Width=" 200"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource 全局_按钮_黑颜色}"
                            BorderThickness="2"
                            FontFamily="{DynamicResource 全局_文字_数字字体}"
                            FontSize="18"
                            Style="{DynamicResource Vision_TextBoxStyle}"
                            Text="{Binding ElementName=Polling_Time_UI, Path=Value, Mode=TwoWay, StringFormat={}{0:F1}}" />

                        <TextBlock
                            Grid.Column=" 3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="16"
                            Foreground="{DynamicResource 全局_按钮_黑颜色}"
                            Text="秒" />
                    </Grid>


                    <Grid Height="35" Margin="0,8,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                            <ColumnDefinition Width=" auto" />
                            <ColumnDefinition Width=" 30                                                           " />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="16"
                            Foreground="{DynamicResource 全局_按钮_黑颜色}"
                            Text="看板更新" />
                        <!--  Client 连续向 Server 上报完整快照时的发送间隔。  -->
                        <Slider
                            x:Name="Sever_Cycle_Update_Time_UI"
                            Grid.Column=" 1"
                            Margin="5"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsSnapToTickEnabled="True"
                            Maximum="10"
                            Minimum="0.1"
                            SmallChange="0.1"
                            Style="{DynamicResource Vision_SliderStyle}"
                            TickFrequency="0.1"
                            Value="{Binding File_Int_Parameters.Mes_Run_Parameters.Sever_Cycle_Update_Time}" />

                        <TextBox
                            Grid.Column=" 2"
                            Width=" 200"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource 全局_按钮_黑颜色}"
                            BorderThickness="2"
                            FontFamily="{DynamicResource 全局_文字_数字字体}"
                            FontSize="18"
                            Style="{DynamicResource Vision_TextBoxStyle}"
                            Text="{Binding ElementName=Sever_Cycle_Update_Time_UI, Path=Value, Mode=TwoWay, StringFormat={}{0:F1}}" />

                        <TextBlock
                            Grid.Column=" 3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="16"
                            Foreground="{DynamicResource 全局_按钮_黑颜色}"
                            Text="秒" />
                    </Grid>

                    <Grid Height="35" Margin="0,8,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                            <ColumnDefinition Width=" auto" />
                            <ColumnDefinition Width=" 30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="16"
                            Foreground="{DynamicResource 全局_按钮_黑颜色}"
                            Text="看板IP" />
