<UserControl
    x:Class="Robot_Info_Mes.View.Client_Modbus_Settings_View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ViewModel="clr-namespace:Robot_Info_Mes.ViewModel"
    d:DataContext="{d:DesignInstance Type=ViewModel:Robot_Info_VM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ModbusFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="FontFamily" Value="{DynamicResource 全局_文字_中文字体}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#65758A" />
        </Style>

        <Style
            x:Key="ModbusFieldTextBoxStyle"
            BasedOn="{StaticResource Vision_TextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource 全局_按钮_黑颜色}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="{DynamicResource 全局_文字_数字字体}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource 全局_按钮_黑颜色}" />
        </Style>

        <Style
            x:Key="ModbusComboBoxStyle"
            BasedOn="{StaticResource Data_ComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource 全局_文字_数字字体}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModbusGridTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="ModbusGridTextBoxStyle"
            BasedOn="{StaticResource Vision_TextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource 全局_文字_中文字体}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ModbusSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#EEF2F5" />
            <Setter Property="BorderBrush" Value="#AEBAC7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#344F6D" />
            <Setter Property="FontFamily" Value="{DynamicResource 全局_文字_中文字体}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ModbusPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModbusSecondaryButtonStyle}">
            <Setter Property="Background" Value="#506F94" />
            <Setter Property="BorderBrush" Value="#506F94" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Width="940" Height="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <!--  标题与服务实时状态。  -->
        <Border
            Panel.ZIndex="1"
            Background="{DynamicResource 全局_按钮_白颜色}"
            BorderBrush="{DynamicResource 全局_背景_蓝颜色}"
            BorderThickness="3,3,3,0"
            CornerRadius="12,12,0,0"
            Effect="{DynamicResource 全局背景阴影}">
            <Grid Margin="22,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="#344F6D"
                        Text="Modbus TCP 服务端设置" />
                    <TextBlock
                        Margin="18,3,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="13"
                        Foreground="#8793A2"
                        Text="地址由起点、唯一 Order 和数据类型自动排位" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Background="#EEF2F5"
                    BorderBrush="#D8E0E7"
                    BorderThickness="1"
                    CornerRadius="14"
                    ToolTip="{Binding ModbusLastErrorText}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#BD5141" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModbusServerIsRunning}" Value="True">
                                            <Setter Property="Fill" Value="#2C8659" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="12"
                            Foreground="#65758A"
                            Text="服务端状态" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{Binding ModbusServerStateText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A14335" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModbusServerIsRunning}" Value="True">
                                            <Setter Property="Foreground" Value="#286E4A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Background="#F5F7F9"
            BorderBrush="{DynamicResource 全局_背景_蓝颜色}"
            BorderThickness="3,0,3,0">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  服务级参数。每个点位的地址不允许人工输入。  -->
                <Border
                    Padding="12"
                    Background="White"
                    BorderBrush="#D8E0E7"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource ModbusFieldLabelStyle}" Text="监听 IP" />
                            <TextBox
                                Style="{StaticResource ModbusFieldTextBoxStyle}"
                                Text="{Binding ModbusTcpConfiguration.BindAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource ModbusFieldLabelStyle}" Text="TCP 端口" />
                            <TextBox
                                Style="{StaticResource ModbusFieldTextBoxStyle}"
                                Text="{Binding ModbusTcpConfiguration.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Style="{StaticResource ModbusFieldLabelStyle}" Text="Unit ID" />
                            <TextBox
                                Style="{StaticResource ModbusFieldTextBoxStyle}"
                                Text="{Binding ModbusTcpConfiguration.UnitIdentifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="6">
                            <TextBlock Style="{StaticResource ModbusFieldLabelStyle}" Text="六位块起点" />
                            <TextBox
                                Style="{StaticResource ModbusFieldTextBoxStyle}"
                                ToolTip="仅允许 400001～465536 六位保持寄存器地址"
                                Text="{Binding ModbusTcpConfiguration.StartReferenceAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="8">
                            <TextBlock Style="{StaticResource ModbusFieldLabelStyle}" Text="刷新周期 ms" />
                            <TextBox
                                Style="{StaticResource ModbusFieldTextBoxStyle}"
                                Text="{Binding ModbusTcpConfiguration.PublishIntervalMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="10">
                            <TextBlock Style="{StaticResource ModbusFieldLabelStyle}" Text="UInt32 字序" />
                            <ComboBox
                                ItemsSource="{Binding ModbusWordOrderOptions}"
                                SelectedItem="{Binding ModbusTcpConfiguration.WordOrder, Mode=TwoWay}"
                                Style="{StaticResource ModbusComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Stretch"
                                            Text="{Binding}"
                                            TextAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Width="85" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource ModbusFieldLabelStyle}" Text="最大连接" />
                            <TextBox
                                Style="{StaticResource ModbusFieldTextBoxStyle}"
                                Text="{Binding ModbusTcpConfiguration.MaxConnections, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Width="95" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource ModbusFieldLabelStyle}" Text="连接超时 秒" />
                            <TextBox
                                Style="{StaticResource ModbusFieldTextBoxStyle}"
                                Text="{Binding ModbusTcpConfiguration.ConnectionTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  点位表：地址、格式和占用字数由公共布局算法实时回填。  -->
                <DataGrid
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    Background="White"
                    BorderBrush="#CBD5DF"
                    BorderThickness="1"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    ColumnHeaderHeight="34"
                    FontFamily="{DynamicResource 全局_文字_中文字体}"
                    FontSize="13"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    HorizontalGridLinesBrush="#E5EAF0"
                    ItemsSource="{Binding ModbusTcpConfiguration.RegisterPoints}"
                    RowHeight="34"
                    SelectedItem="{Binding SelectedModbusRegisterPoint, Mode=TwoWay}">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn
                            Width="48"
                            Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Header="启用">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn
                            Width="68"
                            Binding="{Binding Order, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EditingElementStyle="{StaticResource ModbusGridTextBoxStyle}"
                            ElementStyle="{StaticResource ModbusGridTextStyle}"
                            Header="Order ID" />
                        <DataGridTextColumn
                            Width="92"
                            Binding="{Binding AddressText}"
                            ElementStyle="{StaticResource ModbusGridTextStyle}"
                            Header="自动地址"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="108" Header="数据类型">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        TextAlignment="Center"
                                        Text="{Binding FormatText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Margin="3"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ItemsSource="{Binding DataContext.ModbusPointDataTypeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedItem="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModbusComboBoxStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EditingElementStyle="{StaticResource ModbusGridTextBoxStyle}"
                            ElementStyle="{StaticResource ModbusGridTextStyle}"
                            Header="名称" />
                        <DataGridTextColumn
                            Width="62"
                            Binding="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EditingElementStyle="{StaticResource ModbusGridTextBoxStyle}"
                            ElementStyle="{StaticResource ModbusGridTextStyle}"
                            Header="单位" />
                        <DataGridTextColumn
                            Width="92"
                            Binding="{Binding CurrentValueText}"
                            ElementStyle="{StaticResource ModbusGridTextStyle}"
                            Header="当前值"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EditingElementStyle="{StaticResource ModbusGridTextBoxStyle}"
                            ElementStyle="{StaticResource ModbusGridTextStyle}"
                            Header="备注" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#506F94"
                            Text="{Binding ModbusTcpConfiguration.LayoutValidationMessage}" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="11"
                            Foreground="#8793A2">
                            <Run Text="XML：" />
                            <Run Text="{Binding ModbusTcpConfiguration.ConfigurationFilePath}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#8793A2"
                        Text="修改后点击保存，服务会断开并重新监听" />
                </Grid>
            </Grid>
        </Border>

        <!--  点位维护与服务操作。  -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource 全局_按钮_白颜色}"
            BorderBrush="{DynamicResource 全局_背景_蓝颜色}"
            BorderThickness="3,0,3,3"
            CornerRadius="0,0,12,12">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    Grid.Column="0"
                    Width="100"
                    Height="36"
                    Background="{DynamicResource 全局_按钮_蓝颜色}"
                    Command="{Binding ToggleModbusServerCommand}"
                    IsChecked="{Binding ModbusTcpConfiguration.Enabled, Mode=OneWay}"
                    Style="{DynamicResource CheckBoxStyle1}"
                    ToolTip="开启后立即启动 Modbus TCP 服务端，并在保存配置后于下次启动时自动开启">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource 全局_按钮_白颜色}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="开启服务端" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModbusTcpConfiguration.Enabled}" Value="True">
                                        <Setter Property="Text" Value="关闭服务端" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </CheckBox>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                    <Button
                        Command="{Binding AddModbusUInt16PointCommand}"
                        Content="新增 UInt16"
                        Style="{StaticResource ModbusSecondaryButtonStyle}" />
                    <Button
                        Command="{Binding AddModbusUInt32PointCommand}"
                        Content="新增 UInt32"
                        Style="{StaticResource ModbusSecondaryButtonStyle}" />
                    <Button
                        Command="{Binding DeleteModbusPointCommand}"
                        Content="删除/禁用选中"
                        Style="{StaticResource ModbusSecondaryButtonStyle}" />
                    <Button
                        Command="{Binding RefreshModbusLayoutCommand}"
                        Content="重新排位"
                        Style="{StaticResource ModbusSecondaryButtonStyle}" />
                </StackPanel>

                <Button
                    Grid.Column="3"
                    Width="150"
                    Command="{Binding SaveAndRestartModbusServerCommand}"
                    Content="保存并重启服务端"
                    Style="{StaticResource ModbusPrimaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
