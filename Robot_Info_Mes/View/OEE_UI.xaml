                            Height=" 30"
                            Margin="10,0,10,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource 全局_背景_蓝颜色}"
                            CornerRadius="6"
                            Effect="{DynamicResource 全局背景阴影}">

                            <TextBlock
                                Grid.Row="0"
                                Margin="5,0,5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource 全局_文字_中文字体}"
                                FontSize="12"
                                Foreground="{DynamicResource 全局_背景_白颜色}"
                                Text="DEVICE  •  设备信息" />



                        </Border>



                    </StackPanel>


                    <!--<Border
                        Grid.Row=" 0"
                        Grid.Column="0"
                        Grid.ColumnSpan="5"
                        Height="2"
                        Margin="3,0,3,0"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource 全局_按钮_灰颜色}"
                        CornerRadius=" 0" />-->

                    <Border
                        Grid.Column=" 1"
                        Height="30"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource 全局_按钮_蓝颜色}"
                        CornerRadius="12"
                        Effect="{DynamicResource 全局背景阴影}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource 全局_按钮_绿颜色}" />
                                <Setter Property="Opacity" Value="1" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mes_Robot_Info_Model_Data.Socket_Robot_Connect_State}" Value="{x:Static Robot:Socket_Robot_Connect_State_Enum.Disconnected}">
                                        <Setter Property="Background" Value="{DynamicResource 全局_按钮_红颜色}" />
                                        <Setter Property="Opacity" Value="0.5" />

                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="10,0,0,0"
                                Fill="Black" />
                            <TextBlock
                                Grid.Row="0"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource 全局_文字_中文字体}"
                                FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="设备已连接" />


                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mes_Robot_Info_Model_Data.Socket_Robot_Connect_State}" Value="{x:Static Robot:Socket_Robot_Connect_State_Enum.Disconnected}">
                                                <Setter Property="Text" Value="设备已断开" />

                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>



                        </StackPanel>

                    </Border>




                    <Border
                        Grid.Row=" 1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="10,0,10,0"
                        d:Visibility="Collapsed"
                        BorderBrush="{DynamicResource 全局_按钮_蓝颜色}"
                        BorderThickness="0"
                        CornerRadius=" 6 "
                        Effect="{DynamicResource 全局背景阴影}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Mes_Robot_Info_Model_Data.Image_Source}" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mes_Robot_Info_Model_Data.Socket_Robot_Connect_State}" Value="{x:Static Robot:Socket_Robot_Connect_State_Enum.Disconnected}">
                                        <Setter Property="Opacity" Value="0.2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                    </Border>



                    <Border
                        Grid.Row=" 1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="10,0,10,0"
                        d:Visibility="Collapsed"
                        Background="Black"
                        BorderBrush="{DynamicResource 全局_按钮_蓝颜色}"
                        BorderThickness="0"
                        CornerRadius=" 6 "
                        Effect="{DynamicResource 全局背景阴影}"
                        Opacity=" 0.6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mes_Robot_Info_Model_Data.Socket_Robot_Connect_State}" Value="{x:Static Robot:Socket_Robot_Connect_State_Enum.Disconnected}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <TextBlock
                        Grid.Row=" 1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="24"
                        Foreground="{DynamicResource 全局_按钮_白颜色}"
                        Text="{Binding Mes_Robot_Info_Model_Data.Robot_Offline_Time.Timer_UI, StringFormat='{}离线时间....{0:hh\\:mm\\:ss}'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mes_Robot_Info_Model_Data.Socket_Robot_Connect_State}" Value="{x:Static Robot:Socket_Robot_Connect_State_Enum.Disconnected}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>






                    <TextBlock
                        Grid.Row="2"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource 全局_按钮_深灰颜色}"
                        Text="设备名称" />

                    <TextBlock
                        Grid.Row="3"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{DynamicResource 全局_按钮_蓝颜色}"
                        Text="{Binding Mes_Robot_Info_Model_Data.Robot_Info_Data.Robot_Process_Int, Converter={StaticResource EnumDescriptionConverter}}" />




                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource 全局_按钮_深灰颜色}"
                        Text="当前生产程序" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        d:Text="R1/A195059845675498765436546748"
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="14"
                        Foreground="{DynamicResource 全局_按钮_蓝颜色}"
                        Text="{Binding Mes_Robot_Info_Model_Data.Robot_Info_Data.Mes_Programs_Name, FallbackValue=....}"
                        TextAlignment="Left"
                        TextTrimming="CharacterEllipsis" />

