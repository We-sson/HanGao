        </Grid>


        <Grid
            Grid.Row="1"
            Grid.Column=" 0"
            Margin="5,10,5,0"
            Background="Transparent"
            ClipToBounds="True"
            ShowGridLines="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseEnter">
                    <i:InvokeCommandAction Command="{Binding Work_Factor_Seried.Mes_Data_View_Pause_Comm}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="MouseLeave">
                    <i:InvokeCommandAction Command="{Binding Work_Factor_Seried.Mes_Data_View_Resume_Comm}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>


            <Border
                Grid.RowSpan="2"
                Background="{DynamicResource 全局_背景_白颜色}"
                BorderBrush="{DynamicResource 全局_按钮_蓝颜色}"
                BorderThickness="3"
                CornerRadius="10" />

            <ProgressBar
                Grid.Row="0"
                Height="6"
                Margin="10,7,10,0"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                d:Value="50"
                IsHitTestVisible="False"
                Maximum="100"
                Minimum="0"
                Value="{Binding Work_Factor_Seried.Mes_Data_View_Progress, Mode=OneWay}">
                <ProgressBar.Style>
                    <Style BasedOn="{StaticResource OeeRotationProgressBarStyle}" TargetType="{x:Type ProgressBar}">
                        <Setter Property="Foreground" Value="{StaticResource OEE_时间稼动率_颜色}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index}" Value="1">
                                <Setter Property="Foreground" Value="{StaticResource OEE_性能稼动率_颜色}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index}" Value="2">
                                <Setter Property="Foreground" Value="{StaticResource OEE_生产数量_颜色}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index}" Value="3">
                                <Setter Property="Foreground" Value="{StaticResource OEE_平均节拍_颜色}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index}" Value="4">
                                <Setter Property="Foreground" Value="{StaticResource OEE_作业时间_颜色}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index}" Value="5">
                                <Setter Property="Foreground" Value="{StaticResource OEE_节拍外时间_颜色}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>



            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="10,0,0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <RadioButton
                        Background="{StaticResource OEE_时间稼动率_浅颜色}"
                        BorderBrush="{StaticResource OEE_时间稼动率_颜色}"
                        Content="时间稼动率"
                        IsChecked="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0, Mode=TwoWay}"
                        Style="{StaticResource OeeMetricRadioButtonStyle}" />
                    <RadioButton
                        Background="{StaticResource OEE_性能稼动率_浅颜色}"
                        BorderBrush="{StaticResource OEE_性能稼动率_颜色}"
                        Content="性能稼动率"
                        IsChecked="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1, Mode=TwoWay}"
                        Style="{StaticResource OeeMetricRadioButtonStyle}" />
                    <RadioButton
                        Background="{StaticResource OEE_生产数量_浅颜色}"
                        BorderBrush="{StaticResource OEE_生产数量_颜色}"
                        Content="生产数量"
                        IsChecked="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2, Mode=TwoWay}"
                        Style="{StaticResource OeeMetricRadioButtonStyle}" />
                    <RadioButton
                        Background="{StaticResource OEE_平均节拍_浅颜色}"
                        BorderBrush="{StaticResource OEE_平均节拍_颜色}"
                        Content="平均节拍"
                        IsChecked="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3, Mode=TwoWay}"
                        Style="{StaticResource OeeMetricRadioButtonStyle}" />
                    <RadioButton
                        Background="{StaticResource OEE_作业时间_浅颜色}"
                        BorderBrush="{StaticResource OEE_作业时间_颜色}"
                        Content="作业时间"
                        IsChecked="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=4, Mode=TwoWay}"
                        Style="{StaticResource OeeMetricRadioButtonStyle}" />
                    <RadioButton
                        Background="{StaticResource OEE_节拍外时间_浅颜色}"
                        BorderBrush="{StaticResource OEE_节拍外时间_颜色}"
                        Content="节拍外时间"
                        IsChecked="{Binding Work_Factor_Seried.Mes_Data_View_Selected_Index, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=5, Mode=TwoWay}"
                        Style="{StaticResource OeeMetricRadioButtonStyle}" />
                </StackPanel>








                <lvc:CartesianChart
                    Grid.Column="1"
                    Margin="0,10,10,10"
                    Background="Transparent"
                    EasingFunction="{x:Null}"
                    LegendBackgroundPaint="{Binding Work_Factor_Seried.LedgendBackgroundPaint}"
                    LegendPosition="Hidden"
                    LegendTextPaint="{Binding Work_Factor_Seried.LegendTextPaint}"
                    LegendTextSize="18"
                    Sections="{Binding Work_Factor_Seried.Mes_Data_View_List_Sections}"
                    Series="{Binding Work_Factor_Seried.Mes_Data_View_List_Series}"
                    TooltipTextPaint="{Binding Work_Factor_Seried.TooltipTextPaint}"
                    XAxes="{Binding Work_Factor_Seried.XAxes}"
                    YAxes="{Binding Work_Factor_Seried.YAxes}" />

            </Grid>











        </Grid>



    </Grid>
