                                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                                        FontSize="40"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource 全局_按钮_蓝颜色}"
                                        Text="{Binding Mes_Robot_Info_Model_Data.Robot_Work_ABCD_Cycle_Mean, FallbackValue=...., StringFormat={}{0:F2}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
