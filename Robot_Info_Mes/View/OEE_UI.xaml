    d:DataContext="{Binding Robot_Info_VM, Source={StaticResource ViewModelLocator}}"
    d:Height="1000"
    d:Width="1440"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Enum_Converter:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        <Enum_Converter:IndexEqualsConverter x:Key="IndexEqualsConverter" />
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>

            <RowDefinition Height=" 250" />
            <RowDefinition Height=" auto" />

        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Grid.Column=" 0"
            Margin="5,5,5,0"
            ShowGridLines="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="240" MaxWidth="300" />
                    <ColumnDefinition MinWidth="600" />
                    <ColumnDefinition MinWidth=" 550" MaxWidth="600" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column=" 0">
                    <Grid.ColumnDefinitions>


