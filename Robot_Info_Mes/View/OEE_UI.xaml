<UserControl
    x:Class="Robot_Info_Mes.View.OEE_UI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:View="clr-namespace:Robot_Info_Mes.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{Binding Robot_Info_VM, Source={StaticResource ViewModelLocator}}"
    d:Height="1000"
    d:Width="1440"
    mc:Ignorable="d">
    <!--  DataContext 可为 Client 的 Robot_Info_VM，也可为 Server 列表中的单设备项；两者公开相同绑定路径。  -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="250" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>
        <!--  上半区：设备身份、实时生产数据、效率仪表和状态累计时间。  -->
        <View:OEE_Top_Summary Grid.Row="0" />
        <!--  下半区趋势图：自动轮播六种指标，人工选择与后台索引保持双向同步。  -->
        <View:OEE_Monthly_Trend Grid.Row="1" />
    </Grid>
</UserControl>
