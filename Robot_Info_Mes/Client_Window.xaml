<Window
    x:Class="Robot_Info_Mes.Client_Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Enum_Converter="clr-namespace:Robot_Info_Mes.View"
    xmlns:Robot="clr-namespace:Roboto_Socket_Library.Model;assembly=Roboto_Socket_Library"
    xmlns:View="clr-namespace:Robot_Info_Mes.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Robot_Info_Mes"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewer="clr-namespace:RobotSimulator.Controls;assembly=RobotSimulator.AnyCAD"
    Title="{Binding Window_Version, StringFormat={}设备运行状态读取上位机 V{0}}"
    MinWidth="1440"
    MinHeight="1000"
    d:Height="1000"
    d:Width="1920"
    DataContext="{Binding Robot_Info_VM, Source={StaticResource ViewModelLocator}}"
    WindowState="Maximized"
    mc:Ignorable="d">
    <!--  关闭前由 ViewModel 释放 Modbus；窗口代码后置不参与生命周期处理。  -->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WindowClosingCommand}" PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.Resources>
        <!--  将机器人/工艺枚举显示为 DescriptionAttribute 中的现场中文名称。  -->
        <Enum_Converter:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </Window.Resources>
    <Grid Background="{DynamicResource 全局_背景_白颜色}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height=" auto" />
            <!--  主业务区占用剩余高度，底部三维模型继续向下占满。  -->
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <!--  顶栏：应用标识、页面标题和 Client→Server 实时连接状态。  -->


        <Grid Grid.Row=" 0" Grid.Column=" 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="20,0,20,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource 全局_图标库}"
                FontSize="32"
                Foreground="{DynamicResource 全局_按钮_蓝颜色}"
                Text="&#xe641;" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource 全局_文字_中文字体}"
                FontSize="32"
                Foreground="{DynamicResource 全局_按钮_蓝颜色}"
                Text="设备OEE状态读取页面" />

            <!--  Client 与 Server 看板之间的实际通信状态。  -->
            <Border
                Grid.Row="0"
                Grid.Column="2"
                Height=" 50"
                Margin="0,0,5,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Panel.ZIndex="2"
                Background="White"
                BorderBrush="#D5DCE4"
                BorderThickness="1"
                CornerRadius="9"
                Effect="{DynamicResource 全局背景阴影}">

                <Grid Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Grid
                            Width="18"
                            Height="18"
                            Margin="0,0,10,0">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#E1E7ED" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Connecting}">
                                                <Setter Property="Fill" Value="#DCEAF7" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Ready}">
                                                <Setter Property="Fill" Value="#D9F0E3" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Working}">
                                                <Setter Property="Fill" Value="#F7E8C4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Error}">
                                                <Setter Property="Fill" Value="#F6D9D4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="10" Height="10">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#8793A2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Connecting}">
                                                <Setter Property="Fill" Value="#3979A8" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Ready}">
                                                <Setter Property="Fill" Value="#2C8659" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Working}">
                                                <Setter Property="Fill" Value="#D49A2E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Error}">
                                                <Setter Property="Fill" Value="#BD5141" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>

                        <StackPanel Margin="0,0,5,0" VerticalAlignment="Center">
                            <TextBlock
                                FontFamily="{DynamicResource 全局_文字_中文字体}"
                                FontSize="11"
                                Foreground="#8793A2"
                                Text="看板连接状态" />
                            <TextBlock
                                FontFamily="{DynamicResource 全局_文字_中文字体}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                ToolTip="{Binding Mes_Info_Parameters.Last_Communication_Error}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#65758A" />
                                        <Setter Property="Text" Value="等待连接" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Connecting}">
                                                <Setter Property="Foreground" Value="#3979A8" />
                                                <Setter Property="Text" Value="连接中" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Ready}">
                                                <Setter Property="Foreground" Value="#286E4A" />
                                                <Setter Property="Text" Value="已连接" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Working}">
                                                <Setter Property="Foreground" Value="#946814" />
                                                <Setter Property="Text" Value="发送数据中" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Error}">
                                                <Setter Property="Foreground" Value="#A14335" />
                                                <Setter Property="Text" Value="重连中" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="0,2"
                        Background="#DDE3E9" />

                    <StackPanel
                        Grid.Column="2"
                        Margin="5,0,5,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#8793A2"
                            Text="OEE 看板服务器信息" />
                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_数字字体}"
                            FontSize="14"
                            Foreground="#8A96A5">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}:{1}">
                                    <Binding Path="File_Int_Parameters.Mes_Run_Parameters.Sever_Mes_Info_IP" />
                                    <Binding Path="File_Int_Parameters.Mes_Run_Parameters.Sever_Mes_Info_Port" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <Border
                        Grid.Column="3"
                        Margin="0,2"
                        Background="#DDE3E9" />

                    <StackPanel
                        Grid.Column="4"
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        ToolTip="Ping 仅表示主机网络可达，不代表看板端口和业务回执正常。">
                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="11"
                            Foreground="#8793A2"
                            Text="网络 Ping" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding Mes_Info_Parameters.Ping_Latency_Text}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#65758A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Ping_Is_Reachable}" Value="True">
                                            <Setter Property="Foreground" Value="#286E4A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Ping_Is_Reachable}" Value="False">
                                            <Setter Property="Foreground" Value="#A14335" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border
                        Grid.Column="5"
                        Margin="0,2"
                        Background="#DDE3E9" />

                    <!--  本机 Modbus TCP 服务端监听状态。  -->
                    <StackPanel
                        Grid.Column="6"
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        ToolTip="{Binding Modbus.ModbusLastErrorText}">
                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="11"
                            Foreground="#8793A2"
                            Text="Modbus服务端" />
                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding Modbus.ModbusServerStateText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A14335" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Modbus.ModbusServerIsRunning}" Value="True">
                                            <Setter Property="Foreground" Value="#286E4A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border
                        Grid.Column="7"
                        Margin="0,2"
                        Background="#DDE3E9" />

                    <!--  Modbus TCP 服务端监听地址独立显示，避免与运行状态挤在同一列。  -->
                    <StackPanel
                        Grid.Column="8"
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        ToolTip="{Binding Modbus.ModbusListeningAddressesToolTip}">
                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="11"
                            Foreground="#8793A2"
                            Text="本机监听地址" />
                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_数字字体}"
                            FontSize="14"
                            Foreground="#8A96A5"
                            Text="{Binding Modbus.ModbusEndpointText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border
                        Grid.Column="9"
                        Margin="0,2"
                        Background="#DDE3E9" />

                    <!--  SCADA 客户端连接及最近一次读取状态。  -->
                    <StackPanel
                        Grid.Column="10"
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        ToolTip="{Binding Modbus.ModbusScadaDetailText}">
                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="11"
                            Foreground="#8793A2"
                            Text="SCADA 客户端" />
                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding Modbus.ModbusScadaStateText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#65758A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Modbus.ModbusScadaIsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="#286E4A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
        <!--  命令栏：左侧编辑通信/工艺参数，右侧查看收发报文与运行日志。  -->
        <Grid
            x:Name="Set_UI"
            Grid.Row="1"
            Background="Transparent">
            <!--<Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Height" Value="48" />
                    <Setter Property="Opacity" Value="0.3" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Set_UI}" Value="false ">
                            <Setter Property="Height" Value="300" />
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!--  配置类 Popup 继承按钮所在窗口的 DataContext，修改值直接进入 File_Int_Parameters。  -->
            <StackPanel
                Grid.Column=" 0"
                Margin="8,0"
                Orientation="Horizontal">



                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource 全局_文字_中文字体}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#65758A"
                    Text="参数配置" />

                <Border
                    Width="2"
                    Height="20"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource 全局_按钮_灰蓝颜色}" />

                <ToggleButton
                    x:Name="CommunicationSettingsButton"
                    d:IsChecked="True"
                    Content="通信设置"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=CommunicationSettingsButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=CommunicationSettingsButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Communication_Settings_View />
                </Popup>

                <ToggleButton
                    x:Name="ModbusSettingsButton"
                    Content="Modbus服务端"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=ModbusSettingsButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=ModbusSettingsButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Modbus_Settings_View DataContext="{Binding Modbus}" />
                </Popup>

                <ToggleButton
                    x:Name="ProcessSettingsButton"
                    Content="工艺设置"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=ProcessSettingsButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=ProcessSettingsButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Process_Settings_View />
                </Popup>

                <ToggleButton
                    x:Name="SimulationSettingsButton"
                    Content="仿真设置"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=SimulationSettingsButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=SimulationSettingsButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Simulation_Settings_View />
                </Popup>







            </StackPanel>

            <!--  诊断类 Popup 使用只读监视视图，不干扰主 OEE 面板的布局。  -->
            <StackPanel
                Grid.Column=" 1"
                Margin="8,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">



                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource 全局_文字_中文字体}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#65758A"
                    Text="参数配置" />

                <Border
                    Width="2"
                    Height="20"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource 全局_按钮_灰蓝颜色}" />



                <ToggleButton
                    x:Name="ReceiveMonitorButton"
                    Content="通信接收"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=ReceiveMonitorButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=ReceiveMonitorButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Receive_Monitor_View />
                </Popup>

                <ToggleButton
                    x:Name="SendMonitorButton"
                    Content="通信发送"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=SendMonitorButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=SendMonitorButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Send_Monitor_View />
                </Popup>

                <ToggleButton
                    x:Name="LogMonitorButton"
                    Width="58"
                    Content="日志"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=LogMonitorButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=LogMonitorButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Log_Monitor_View />
                </Popup>





            </StackPanel>



        </Grid>

        <!--  主业务区复用单设备 OEE 控件；高度不足时允许纵向滚动。  -->
        <Grid Grid.Row=" 2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <View:OEE_UI DataContext="{Binding}" />
            </Grid>

            <!--  底部三维模型：固定机器人/Tool/工装的组合，只接收 J1～J6。  -->
            <Border
                Grid.Row="1"
                Margin="5,5,5,5"
                Background="Transparent"
                BorderBrush="{DynamicResource 全局_按钮_蓝颜色}"
                BorderThickness="3"
                CornerRadius="10"
                Effect="{DynamicResource 全局背景阴影}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
                <!--  渐变与三维视口的 LightBlue 背景边缘一致，填充边框与视口之间的缝隙。  -->

                <!--  关节跟随参数由 Configs_Data.Xml 的 Mes_Digital_Simulation 提供。  -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <viewer:RobotViewer
                        x:Name="SimulationViewer"
                        Grid.Row="0"
                        Margin="0"
                        Model="{Binding Digital_Simulation}"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True" />
                    <!--  原生视口不支持 WPF 覆盖，状态文字放在视口下方的独立行，不再用 Popup 叠加。  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="10,2,0,2"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        FontSize="12"
                        Foreground="#1A2433"
                        Text="{Binding Digital_Simulation.StatusMessage}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>


    </Grid>
</Window>
