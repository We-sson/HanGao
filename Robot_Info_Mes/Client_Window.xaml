                                        Text="看板端口" />


                                    <TextBox
                                        Grid.Column=" 2"
                                        Width=" 200"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource 全局_按钮_黑颜色}"
                                        BorderThickness="2"
