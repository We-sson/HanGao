<Window
    x:Class="Robot_Info_Mes.Client_Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Enum_Converter="clr-namespace:Robot_Info_Mes.View"
    xmlns:Robot="clr-namespace:Roboto_Socket_Library.Model;assembly=Roboto_Socket_Library"
    xmlns:View="clr-namespace:Robot_Info_Mes.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Robot_Info_Mes"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Window_Version, StringFormat={}设备运行状态读取上位机 V{0}}"
    MinWidth="1440"
    MinHeight="1000"
    d:Height="1000"
    d:Width="1920"
    DataContext="{Binding Robot_Info_VM, Source={StaticResource ViewModelLocator}}"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  将机器人/工艺枚举显示为 DescriptionAttribute 中的现场中文名称。  -->
        <Enum_Converter:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </Window.Resources>
    <Grid Background="{DynamicResource 全局_背景_白颜色}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height=" auto" />
            <RowDefinition Height=" auto" />

        </Grid.RowDefinitions>

        <!--  顶栏：应用标识、页面标题和 Client→Server 实时连接状态。  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="20,0,20,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource 全局_图标库}"
            FontSize="32"
            Foreground="{DynamicResource 全局_按钮_蓝颜色}"
            Text="&#xe641;" />

        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource 全局_文字_中文字体}"
            FontSize="32"
            Foreground="{DynamicResource 全局_按钮_蓝颜色}"
            Text="设备OEE状态读取页面" />

        <!--  Client 与 Server 看板之间的实际通信状态。  -->
        <Border
            Grid.Row="0"
            Width="360"
            Height=" 50"
            Margin="0,0,5,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Panel.ZIndex="2"
            Background="White"
            BorderBrush="#D5DCE4"
            BorderThickness="1"
            CornerRadius="9"
            Effect="{DynamicResource 全局背景阴影}">

            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Grid
                        Width="18"
                        Height="18"
                        Margin="0,0,10,0">
                        <Ellipse>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#E1E7ED" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Connecting}">
                                            <Setter Property="Fill" Value="#DCEAF7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Ready}">
                                            <Setter Property="Fill" Value="#D9F0E3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Working}">
                                            <Setter Property="Fill" Value="#F7E8C4" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Error}">
                                            <Setter Property="Fill" Value="#F6D9D4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="10" Height="10">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#8793A2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Connecting}">
                                            <Setter Property="Fill" Value="#3979A8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Ready}">
                                            <Setter Property="Fill" Value="#2C8659" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Working}">
                                            <Setter Property="Fill" Value="#D49A2E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Error}">
                                            <Setter Property="Fill" Value="#BD5141" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="11"
                            Foreground="#8793A2"
                            Text="看板连接状态" />
                        <TextBlock
                            FontFamily="{DynamicResource 全局_文字_中文字体}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            ToolTip="{Binding Mes_Info_Parameters.Last_Communication_Error}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#65758A" />
                                    <Setter Property="Text" Value="等待连接" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Connecting}">
                                            <Setter Property="Foreground" Value="#3979A8" />
                                            <Setter Property="Text" Value="连接中" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Ready}">
                                            <Setter Property="Foreground" Value="#286E4A" />
                                            <Setter Property="Text" Value="已连接" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Working}">
                                            <Setter Property="Foreground" Value="#946814" />
                                            <Setter Property="Text" Value="发送数据中" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mes_Info_Parameters.Socket_Client_Type_State}" Value="{x:Static Robot:Socket_Robot_Type_Enum.Error}">
                                            <Setter Property="Foreground" Value="#A14335" />
                                            <Setter Property="Text" Value="重连中" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Margin="0,2"
                    Background="#DDE3E9" />

                <StackPanel
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#344F6D"
                        Text="OEE 看板服务器信息" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="14"
                        Foreground="#8A96A5">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}:{1}">
                                <Binding Path="File_Int_Parameters.Mes_Run_Parameters.Sever_Mes_Info_IP" />
                                <Binding Path="File_Int_Parameters.Mes_Run_Parameters.Sever_Mes_Info_Port" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <Border
                    Grid.Column="3"
                    Margin="0,2"
                    Background="#DDE3E9" />

                <StackPanel
                    Grid.Column="4"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="Ping 仅表示主机网络可达，不代表看板端口和业务回执正常。">
                    <TextBlock
                        FontFamily="{DynamicResource 全局_文字_中文字体}"
                        FontSize="11"
                        Foreground="#8793A2"
                        Text="网络 Ping" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding Mes_Info_Parameters.Ping_Latency_Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#65758A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mes_Info_Parameters.Ping_Is_Reachable}" Value="True">
                                        <Setter Property="Foreground" Value="#286E4A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mes_Info_Parameters.Ping_Is_Reachable}" Value="False">
                                        <Setter Property="Foreground" Value="#A14335" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!--  命令栏：左侧编辑通信/工艺参数，右侧查看收发报文与运行日志。  -->
        <Grid
            x:Name="Set_UI"
            Grid.Row="1"
            Background="Transparent">
            <!--<Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Height" Value="48" />
                    <Setter Property="Opacity" Value="0.3" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Set_UI}" Value="false ">
                            <Setter Property="Height" Value="300" />
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!--  配置类 Popup 继承按钮所在窗口的 DataContext，修改值直接进入 File_Int_Parameters。  -->
            <StackPanel
                Grid.Column=" 0"
                Margin="8,0"
                Orientation="Horizontal">



                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource 全局_文字_中文字体}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#65758A"
                    Text="参数配置" />

                <Border
                    Width="2"
                    Height="20"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource 全局_按钮_灰蓝颜色}" />

                <ToggleButton
                    x:Name="CommunicationSettingsButton"
                    d:IsChecked="True"
                    Content="通信设置"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=CommunicationSettingsButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=CommunicationSettingsButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Communication_Settings_View />
                </Popup>

                <ToggleButton
                    x:Name="ProcessSettingsButton"
                    Content="工艺设置"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=ProcessSettingsButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=ProcessSettingsButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Process_Settings_View />
                </Popup>







            </StackPanel>

            <!--  诊断类 Popup 使用只读监视视图，不干扰主 OEE 面板的布局。  -->
            <StackPanel
                Grid.Column=" 1"
                Margin="8,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">



                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource 全局_文字_中文字体}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#65758A"
                    Text="参数配置" />

                <Border
                    Width="2"
                    Height="20"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource 全局_按钮_灰蓝颜色}" />



                <ToggleButton
                    x:Name="ReceiveMonitorButton"
                    Content="通信接收"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=ReceiveMonitorButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=ReceiveMonitorButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Receive_Monitor_View />
                </Popup>

                <ToggleButton
                    x:Name="SendMonitorButton"
                    Content="通信发送"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=SendMonitorButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=SendMonitorButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Send_Monitor_View />
                </Popup>

                <ToggleButton
                    x:Name="LogMonitorButton"
                    Width="58"
                    Content="日志"
                    Style="{StaticResource PopupCompareButtonStyle}" />
                <Popup
                    AllowsTransparency="True"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    IsOpen="{Binding IsChecked, ElementName=LogMonitorButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=LogMonitorButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <View:Client_Log_Monitor_View />
                </Popup>





            </StackPanel>

            <!--  以下大段为旧版 TabControl 参数/监视布局，整体注释保留作视觉迁移参考，不参与编译。  -->
            <!--<Grid
                Grid.Column="0"
                Margin="5"
                Visibility="Visible">




            -->
