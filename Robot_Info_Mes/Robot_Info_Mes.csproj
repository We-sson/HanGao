<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--  SkiaSharp.Views.WPF 3.119.0 只提供 net462 与 Windows 10.0.19041 资产；
          使用 windows10.0.19041 目标避免回退到 .NET Framework 版 OpenTK 3.3.1。  -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AnalysisLevel>preview</AnalysisLevel>
    <UseWindowsForms>True</UseWindowsForms>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <FileVersion></FileVersion>
    <AssemblyVersion></AssemblyVersion>
    <ApplicationIcon>Resources\软件图标.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <WarningLevel>8</WarningLevel>
    <Deterministic>false</Deterministic>
    <NoWarn>1701;1702;1416;DV2001;CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <WarningLevel>8</WarningLevel>
    <Deterministic>false</Deterministic>
    <NoWarn>1701;1702;1416;DV2001;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\1楼面板.png" />
    <None Remove="Resources\2楼面板.jpg" />
    <None Remove="Resources\7线R边.png" />
    <None Remove="Resources\7线围边.png" />
    <None Remove="Resources\8线R边.png" />
    <None Remove="Resources\8线围边.png" />
    <None Remove="Resources\8线激光点焊.jpg" />
    <None Remove="Resources\9线R边.png" />
    <None Remove="Resources\9线围边.png" />
    <None Remove="Resources\9线激光点焊.jpg" />
    <None Remove="Resources\Control_设备日志_ioc.png" />
    <None Remove="Resources\光华拉伸激光切割_1.jpg" />
    <None Remove="Resources\光华点焊围边焊接_1.jpg" />
    <None Remove="Resources\软件图标.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="Nancy" Version="2.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Generic_Extension\Generic_Extension.csproj" />
    <ProjectReference Include="..\HanGao.ModbusTcp\HanGao.ModbusTcp.csproj" />
    <ProjectReference Include="..\Roboto_Socket_Library\Roboto_Socket_Library.csproj" />
    <!-- Modbus TCP 功能库：配置、服务端、状态和命令。 -->
    <ProjectReference Include="..\HanGao.RobotInfo.Modbus\HanGao.RobotInfo.Modbus.csproj" />
    <!-- 三维模型控件固定在主页面下方显示；控件与模型都在 RobotSimulator.AnyCAD 内。 -->
    <ProjectReference Include="..\RobotSimulator.AnyCAD\RobotSimulator.AnyCAD.csproj" />
  </ItemGroup>

  <!--
    三维控件依赖 AnyCAD 的完整模块和原生库；这些文件由主程序构建后统一复制，
    避免使用 NuGet 包中版本不一致的旧程序集覆盖编译期引用。
  -->
  <Target Name="CopyAnyCadRuntime" AfterTargets="Build">
    <PropertyGroup>
      <RobotSimulatorOutput>$(MSBuildThisFileDirectory)..\RobotSimulator.AnyCAD\bin\$(Configuration)\net10.0-windows\win-x64\</RobotSimulatorOutput>
    </PropertyGroup>
    <Error Condition="!Exists('$(RobotSimulatorOutput)AnyCAD.Foundation.NET.dll')"
           Text="未找到主程序输出目录：$(RobotSimulatorOutput)，请先构建 RobotSimulator.AnyCAD。" />
    <ItemGroup>
      <AnyCadRuntime Include="$(RobotSimulatorOutput)AnyCAD*.dll;$(RobotSimulatorOutput)TK*.dll;$(RobotSimulatorOutput)Ifc*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AnyCadRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Resource Include="Resources\1楼面板.png" />
    <Resource Include="Resources\2楼面板.jpg" />
    <Resource Include="Resources\7线R边.png" />
    <Resource Include="Resources\7线围边.png" />
    <Resource Include="Resources\8线R边.png" />
    <Resource Include="Resources\8线围边.png" />
    <Resource Include="Resources\8线激光点焊.jpg" />
    <Resource Include="Resources\9线R边.png" />
    <Resource Include="Resources\9线围边.png" />
    <Resource Include="Resources\9线激光点焊.jpg" />
    <Resource Include="Resources\Control_设备日志_ioc.png" />
    <Resource Include="Resources\iconfont.ttf" />
    <Resource Include="Resources\Vision_下拉选择_ioc.png" />
    <Resource Include="Resources\光华拉伸激光切割_1.jpg" />
    <Resource Include="Resources\光华点焊围边焊接_1.jpg" />
    <Content Include="Resources\软件图标.ico" />
  </ItemGroup>

</Project>
